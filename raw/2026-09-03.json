[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_large.png?m=1643940920", "name": "ev", "avatar_normal": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_normal.png?m=1643940920", "title": "电动汽车", "url": "https://www.v2ex.com/go/ev", "topics": 473, "footer": "", "header": "", "title_alternative": "EV", "avatar_mini": "https://cdn.v2ex.com/navatar/bdb1/06a0/1034_mini.png?m=1643940920", "stars": 464, "founder_id": 0, "aliases": [], "root": false, "id": 1034, "parent_node_name": "tech"}, "member": {"id": 547294, "username": "Wsdba", "url": "https://www.v2ex.com/u/Wsdba", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/6369/6212/547294_mini.png?m=1682503720", "avatar_normal": "https://cdn.v2ex.com/avatar/6369/6212/547294_normal.png?m=1682503720", "avatar_large": "https://cdn.v2ex.com/avatar/6369/6212/547294_large.png?m=1682503720", "avatar_xlarge": "https://cdn.v2ex.com/avatar/6369/6212/547294_xlarge.png?m=1682503720", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/6369/6212/547294_xxlarge.png?m=1682503720", "created": 1622772877, "last_modified": 1682503720, "pro": 0}, "last_reply_by": "savingrun", "last_touched": 1788371540, "title": "顶不住了，来回通勤 60 公里， 12 万内电车求推荐", "url": "https://www.v2ex.com/t/1238971", "created": 1788337566, "deleted": 0, "content": "地铁不通，坐公交要接近三小时。 目前是坐的同事的顺风车，但是这个司机太恶心了，一开始说送我到家，后来送到公交站，再后来乱放了。。现在每天把顺风车打开了，顺我的情况还要接单，最后送我，导致我每天通勤 4-5 小时。他接不到单的时候，半路会停车去吃饭，让我在路边等。。实在是忍不了。。  \r\n\r\nmg07 、启源 Q05 、深蓝 s05 怎么选择呢，还有更好的吗。  \r\n\r\n坐标南方，没有家充。", "content_rendered": "<p>地铁不通，坐公交要接近三小时。 目前是坐的同事的顺风车，但是这个司机太恶心了，一开始说送我到家，后来送到公交站，再后来乱放了。。现在每天把顺风车打开了，顺我的情况还要接单，最后送我，导致我每天通勤 4-5 小时。他接不到单的时候，半路会停车去吃饭，让我在路边等。。实在是忍不了。。  </p>\n<p>mg07 、启源 Q05 、深蓝 s05 怎么选择呢，还有更好的吗。  </p>\n<p>坐标南方，没有家充。</p>\n", "last_modified": 1788337746, "replies": 132, "id": 1238971}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fc22/1309/181_large.png?m=1608240651", "name": "travel", "avatar_normal": "https://cdn.v2ex.com/navatar/fc22/1309/181_normal.png?m=1608240651", "title": "旅行", "url": "https://www.v2ex.com/go/travel", "topics": 1695, "footer": "", "header": "你会把上大学的学费用来环游世界么？", "title_alternative": "Travel", "avatar_mini": "https://cdn.v2ex.com/navatar/fc22/1309/181_mini.png?m=1608240651", "stars": 1351, "founder_id": 0, "aliases": [], "root": false, "id": 181, "parent_node_name": "life"}, "member": {"id": 472907, "username": "KamL", "url": "https://www.v2ex.com/u/KamL", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/2686681da1fef78a61e2457856176794?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/2686681da1fef78a61e2457856176794?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/2686681da1fef78a61e2457856176794?s=73&d=retro", "created": 1582838571, "last_modified": 1702625941, "pro": 0}, "last_reply_by": "suikatw", "last_touched": 1788389139, "title": "中秋去云南旅游，让 gpt 跑了一下线路推荐，也跟问过同事推荐。但是同行的说怕地方太多了.", "url": "https://www.v2ex.com/t/1238848", "created": 1788315772, "deleted": 0, "content": "先列出行程：\r\n9/24 上海 → 昆明\r\n\r\n9/25 昆明 → 大理｜古城＋龙龛\r\n\r\n9/26 大理｜洱海精华＋喜洲＋双廊\r\n\r\n9/27 大理 → 香格里拉｜独克宗\r\n\r\n9/28 香格里拉｜松赞林寺＋纳帕海\r\n\r\n9/29 虎跳峡 / 香格里拉机动日\r\n\r\n9/30 香格里拉 → 白马雪山 → 飞来寺\r\n\r\n10/1 梅里日照金山 → 香格里拉 → 丽江\r\n\r\n10/2 丽江 回程（飞机\r\n\r\n现在机票和酒店都还没定，只是计划行程。但同行的担心去的地方太多了，玩不好有没有大佬推荐一下哪里需要精简的景点呢或者有更好的替代地方？我想去云南主要是想去看洱海和日照金山，不过后者这个比较看运气，预算两个人大概总共 8000 左右吧。然后我看有些人推荐自驾，也有推荐不要自驾的。", "content_rendered": "先列出行程：<br />9/24 上海 → 昆明<br /><br />9/25 昆明 → 大理｜古城＋龙龛<br /><br />9/26 大理｜洱海精华＋喜洲＋双廊<br /><br />9/27 大理 → 香格里拉｜独克宗<br /><br />9/28 香格里拉｜松赞林寺＋纳帕海<br /><br />9/29 虎跳峡 / 香格里拉机动日<br /><br />9/30 香格里拉 → 白马雪山 → 飞来寺<br /><br />10/1 梅里日照金山 → 香格里拉 → 丽江<br /><br />10/2 丽江 回程（飞机<br /><br />现在机票和酒店都还没定，只是计划行程。但同行的担心去的地方太多了，玩不好有没有大佬推荐一下哪里需要精简的景点呢或者有更好的替代地方？我想去云南主要是想去看洱海和日照金山，不过后者这个比较看运气，预算两个人大概总共 8000 左右吧。然后我看有些人推荐自驾，也有推荐不要自驾的。", "last_modified": 1788316691, "replies": 81, "id": 1238848}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a4a0/42cf/171_large.png?m=1782097568", "name": "invest", "avatar_normal": "https://cdn.v2ex.com/navatar/a4a0/42cf/171_normal.png?m=1782097568", "title": "投资", "url": "https://www.v2ex.com/go/invest", "topics": 3796, "footer": "", "header": "Can you make money with money?", "title_alternative": "Invest", "avatar_mini": "https://cdn.v2ex.com/navatar/a4a0/42cf/171_mini.png?m=1782097568", "stars": 4628, "founder_id": 0, "aliases": [], "root": false, "id": 171, "parent_node_name": ""}, "member": {"id": 604094, "username": "haodudecao", "url": "https://www.v2ex.com/u/haodudecao", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/e9240115609c46c20a44f4ef3a6b9911?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/e9240115609c46c20a44f4ef3a6b9911?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/e9240115609c46c20a44f4ef3a6b9911?s=73&d=retro", "created": 1669801444, "last_modified": 1669801444, "pro": 0}, "last_reply_by": "JoJoWuBeHumble", "last_touched": 1788382975, "title": "看到大家分享的炒股经历，有亏有赚。但是这个节点叫投资，炒股不属于投资", "url": "https://www.v2ex.com/t/1238912", "created": 1788328967, "deleted": 0, "content": "炒股=投机≈赌博，\r\n如果理解不了可以想一下买房和炒房\r\n赌博能赚到钱吗？当然可以。但也会让你血本无归\r\n所以炒股赚到钱了，对大家来说没有任何参考性。", "content_rendered": "<p>炒股=投机≈赌博，\n如果理解不了可以想一下买房和炒房\n赌博能赚到钱吗？当然可以。但也会让你血本无归\n所以炒股赚到钱了，对大家来说没有任何参考性。</p>\n", "last_modified": 1788328967, "replies": 77, "id": 1238912}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11617, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "htt