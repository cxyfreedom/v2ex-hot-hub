[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24494, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3746, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 594551, "username": "Orris", "url": "https://www.v2ex.com/u/Orris", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_mini.png?m=1691393963", "avatar_normal": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_normal.png?m=1691393963", "avatar_large": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_large.png?m=1691393963", "avatar_xlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xlarge.png?m=1691393963", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxlarge.png?m=1691393963", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/8936/2fe6/594551_xxxlarge.png?m=1691393963", "created": 1663333667, "last_modified": 1691393963, "pro": 0}, "last_reply_by": "gurachin", "last_touched": 1790847670, "title": "节前最后一天，被裁员了。", "url": "https://www.v2ex.com/t/1245891", "created": 1790766879, "deleted": 0, "content": "下午三点，正想着待会吃啥，人事突然叫我去办公室，然后就是宣布裁员，N+1 ，走流程。\r\n\r\n人生第一次经历裁员，我到现在整个人都还是懵的。 回家的地铁上下载了 BOSS 直聘，随便搜了几个前端岗位，脑子烦躁的根本看不下去。\r\n\r\n和另一个同样被裁的同事聊了几句，他说市面上现在都不招前端了，招全栈和 Agent 开发，听得我头大如斗，我的三脚猫 golang 和 php 能算全栈吗？\r\n\r\n储蓄还有两万，赔偿金和本月工资一起在 10 号发放，但房租 11 月就要到期了。 我很发愁再找不到工作还能干啥？唉。", "content_rendered": "<p>下午三点，正想着待会吃啥，人事突然叫我去办公室，然后就是宣布裁员，N+1 ，走流程。</p>\n<p>人生第一次经历裁员，我到现在整个人都还是懵的。 回家的地铁上下载了 BOSS 直聘，随便搜了几个前端岗位，脑子烦躁的根本看不下去。</p>\n<p>和另一个同样被裁的同事聊了几句，他说市面上现在都不招前端了，招全栈和 Agent 开发，听得我头大如斗，我的三脚猫 golang 和 php 能算全栈吗？</p>\n<p>储蓄还有两万，赔偿金和本月工资一起在 10 号发放，但房租 11 月就要到期了。 我很发愁再找不到工作还能干啥？唉。</p>\n", "last_modified": 1790815860, "replies": 57, "id": 1245891}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73671, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9792, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 240871, "username": "zackkk", "url": "https://www.v2ex.com/u/zackkk", "website": "https://tigg.cc", "twitter": "", "psn": "", "github": "", "btc": "", "location": "东京", "tagline": "东京，码代码，码字，码一切东西", "bio": "特别喜欢骑车，骑遍整个日本。", "avatar_mini": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_mini.png?m=1789866502", "avatar_normal": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_normal.png?m=1789866502", "avatar_large": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_large.png?m=1789866502", "avatar_xlarge": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_xlarge.png?m=1789866502", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_xxlarge.png?m=1789866502", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/b9c7/2bd6/240871_xxxlarge.png?m=1789866502", "created": 1500344816, "last_modified": 1789866502, "pro": 0}, "last_reply_by": "moefishtang", "last_touched": 1790848378, "title": "产品形态来说，好多咱们的程序员以为 APP > WEB", "url": "https://www.v2ex.com/t/1245970", "created": 1790820783, "deleted": 0, "content": "web 在咱们这边也有回归的趋势。\r\n规范一直在升级，性能和其他优势越来越多\r\n\r\n而且只是在咱们这边被无法描述的原因，让 APP 横扫一切，但其实地球上不全是这样的\r\n我感觉是喜欢 web", "content_rendered": "<p>web 在咱们这边也有回归的趋势。\n规范一直在升级，性能和其他优势越来越多</p>\n<p>而且只是在咱们这边被无法描述的原因，让 APP 横扫一切，但其实地球上不全是这样的\n我感觉是喜欢 web</p>\n", "last_modified": 1790820783, "replies": 41, "id": 1245970}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73671, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9792, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 758918, "username": "DeepSIeep", "url": "https://www.v2ex.com/u/DeepSIeep", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/142d/6dc1/758918_mini.png?m=1785124240", "avatar_normal": "https://cdn.v2ex.com/avatar/142d/6dc1/758918_normal.png?m=1785124240", "avatar_large": "https://cdn.v2ex.com/avatar/142d/6dc1/758918_large.png?m=1785124240", "created": 1753236507, "last_modified": 1785124240, "pro": 0}, "last_reply_by": "qiaobeier", "last_touched": 1790840641, "title": "AI 写的项目，让 AI 排查问题。但是有没有感觉沟通过程中读 AI 说的话很费劲，很难懂。。。", "url": "https://www.v2ex.com/t/1245889", "created": 1790765708, "deleted": 0, "content": "", "content_rendered": "", "last_modified": 1790765708, "replies": 27, "id": 1245889}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 11803, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2495, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 367295, "username": "iixy", "url": "https://www.v2ex.com/u/iixy", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/5fad/1233/367295_mini.png?m=1775722356", "avatar_normal": "https://cdn.v2ex.com/avatar/5fad/1233/367295_normal.png?m=1775722356", "avatar_large": "https://cdn.v2ex.com/avatar/5fad/1233/367295_large.png?m=1775722356", "avatar_xlarge": "https://cdn.v2ex.com/avatar/5fad/1233/367295_xlarge.png?m=1775722356", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/5fad/1233/367295_xxlarge.png?m=1775722356", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/5fad/1233/367295_xxxlarge.png?m=1775722356", "created": 1543736687, "last_modified": 1775722356, "pro": 0}, "last_reply_by": "ndxxx", "last_touched": 1790848543, "title": "小区净水器 or 家用净水器选择？", "url": "https://www.v2ex.com/t/1245961", "created": 1790817381, "deleted": 0, "content": "前面几年一直用的小区内装的康基净水器，大概 2 天接一次，我用的 15L 的桶，一次 4 元（折扣前）。\r\n\r\n我一次充大几百有赠送余额，算下来每年实际费用大概在 500 元左右。\r\n\r\n现在在想有没有必要装个家用净水器，又担心小型的家用净水器达不到小区大设备的那个效果，而且装着麻烦占地。不知道要买多少钱的净水器才能达到效果？不追求直饮但要几乎无水垢的。\r\n\r\n自己接水的问题就是有点费人。", "content_rendered": "<p>前面几年一直用的小区内装的康基净水器，大概 2 天接一次，我用的 15L 的桶，一次 4 元（折扣前）。</p>\n<p>我一次充大几百有赠送余额，算下来每年实际费用大概在 500 元左右。</p>\n<p>现在在想有没有必要装个家用净水器，又担心小型的家用净水器达不到小区大设备的那个效果，而且装着麻烦占地。不知道要买多少钱的净水器才能达到效果？不追求直饮但要几乎无水垢的。</p>\n<p>自己接水的问题就是有点费人。</p>\n", "last_modified": 1790817485, "replies": 23, "id": 1245961}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_large.png?m=1751736790", "name": "claude", "avatar_normal": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_normal.png?m=1751736790", "title": "Claude", "url": "https://www.v2ex.com/go/claude", "topics": 963, "footer": "", "header": "", "title_alternative": "Claude", "avatar_mini": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_mini.png?m=1751736790", "stars": 728, "founder_id": 0, "aliases": [], "root": false, "id": 1148, "parent_node_name": "geek"}, "member": {"id": 102641, "username": "milkleeeeee", "url": "https://www.v2ex.com/u/milkleeeeee", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_mini.png?m=1641529094", "avatar_normal": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_normal.png?m=1641529094", "avatar_large": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_large.png?m=1641529094", "avatar_xlarge": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_xlarge.png?m=1641529094", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/f8d0/1045/102641_xxlarge.png?m=1641529094", "created": 1425548795, "last_modified": 1641529094, "pro": 0}, "last_reply_by": "lightyisu", "last_touched": 1790843245, "title": "号被封了……", "url": "https://www.v2ex.com/t/1245975", "created": 1790822687, "deleted": 0, "content": "前情提要： https://www.v2ex.com/t/1244849\r\n\r\n一大早收到了两封邮件，内容一模一样……正在填申诉内容\r\n\r\n```\r\nYour account has been suspended\r\n\r\nHello,\r\n\r\nAn internal investigation of suspicious signals associated with your account indicates a violation of our Usage Policy. As a result, we have revoked your access to Claude.\r\n\r\nTo appeal our decision, log in to claude.ai with this account and you'll be taken to the appeals page. You can learn more about the process here.\r\n\r\nRegards\r\n\r\nAnthropic's Safeguards Team\r\n```", "content_rendered": "<p>前情提要： <a href=\"https://www.v2ex.com/t/1244849\" rel=\"nofollow\">https://www.v2ex.com/t/1244849</a></p>\n<p>一大早收到了两封邮件，内容一模一样……正在填申诉内容</p>\n<pre><code>Your account has been suspended\n\nHello,\n\nAn internal investigation of suspicious signals associated with your account indicates a violation of our Usage Policy. As a result, we have revoked your access to Claude.\n\nTo appeal our decision, log in to claude.ai with this account and you'll be taken to the appeals page. You can learn more about the process here.\n\nRegards\n\nAnthropic's Safeguards Team\n</code></pre>\n", "last_modified": 1790822687, "replies": 23, "id": 1245975}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c74d/97b0/16_large.png?m=1727584731", "name": "share", "avatar_normal": "https://cdn.v2ex.com/navatar/c74d/97b0/16_normal.png?m=1727584731", "title": "分享发现", "url": "https://www.v2ex.com/go/share", "topics": 47367, "footer": "", "header": "分享你看到的好玩的，有信息量的，欢迎从这里获取灵感。", "title_alternative": "Share", "avatar_mini": "https://cdn.v2ex.com/navatar/c74d/97b0/16_mini.png?m=1727584731", "stars": 6360, "founder_id": 0, "aliases": [], "root": false, "id": 16, "parent_node_name": "v2ex"}, "member": {"id": 679304, "username": "osilinka", "url": "https://www.v2ex.com/u/osilinka", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_mini.png?m=1782664383", "avatar_normal": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_normal.png?m=1782664383", "avatar_large": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_large.png?m=1782664383", "avatar_xlarge": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_xlarge.png?m=1782664383", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_xxlarge.png?m=1782664383", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/06bc/eb98/679304_xxxlarge.png?m=1782664383", "created": 1709826073, "last_modified": 1782664383, "pro": 0}, "last_reply_by": "Simle100", "last_touched": 1790831162, "title": "Gemini 4 出来了，吊打其他的公司啊", "url": "https://www.v2ex.com/t/1245940", "created": 1790799912, "deleted": 0, "content": "Gemini 4 出来了，吊打其他的公司啊\r\n周三，该公司发布了 Gemini4Argon ，这是迄今为止最先进的人工智能模型，在编码、网络安全和复杂的专业工作方面提供了重大改进。\r\n该公司表示，该模型在现实世界的软件工程方面创造了新的记录，在网络安\r\n全方面并列第一，并在衡量金融、法律和其他专业任务绩效的另一项基准中\r\n领先。\r\n谷歌表示，Argon 已在公司内部用于优化其数据中心的内存，无需购买额外硬件即可释放数百 TB 的内存。量子计算研究人员也已利用了该模型。", "content_rendered": "<p>Gemini 4 出来了，吊打其他的公司啊\n周三，该公司发布了 Gemini4Argon ，这是迄今为止最先进的人工智能模型，在编码、网络安全和复杂的专业工作方面提供了重大改进。\n该公司表示，该模型在现实世界的软件工程方面创造了新的记录，在网络安\n全方面并列第一，并在衡量金融、法律和其他专业任务绩效的另一项基准中\n领先。\n谷歌表示，Argon 已在公司内部用于优化其数据中心的内存，无需购买额外硬件即可释放数百 TB 的内存。量子计算研究人员也已利用了该模型。</p>\n", "last_modified": 1790799912, "replies": 22, "id": 1245940}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 73671, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9792, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 667538, "username": "street000", "url": "https://www.v2ex.com/u/street000", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/c9cbf77b2c201958de61a5e8278ac97c?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/c9cbf77b2c201958de61a5e8278ac97c?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/c9cbf77b2c201958de61a5e8278ac97c?s=73&d=retro", "created": 1702897016, "last_modified": 1778505170, "pro": 0}, "last_reply_by": "XTTX", "last_touched": 1790845726, "title": "Gemini 4 Argon 已宣布", "url": "https://www.v2ex.com/t/1245947", "created": 1790813021, "deleted": 0, "content": "目前未公开发布，只对美国政府和信任测试者提供。\r\n\r\n多个 Benchmark 超过 Opus 5.5：\r\n![]( https://storage.googleapis.com/gweb-uniblog-publish-prod/original_images/gemini-4-argon_table_blog.gif)\r\n\r\nAAI Index 53 分，介于 GPT 6.1 Sol 和 GPT 6 Astra：\r\n![]( https://pbs.twimg.com/media/HTfY3plasAAay9f?format=jpg&name=large)\r\n\r\nText Arena #1 ，超过 Opus 4.6 ，预计依然会说人话，依然是讨好型人格：\r\n![]( https://pbs.twimg.com/media/HTfdN2Ka4AA3Jdk?format=jpg&name=large)\r\n\r\nWebDev Arena #8 ，和 Opus 有较大差距：\r\n![]( https://pbs.twimg.com/media/HTfdNJTbUAAo-l6?format=jpg&name=large)\r\n\r\n博客：\r\nhttps://blog.google/innovation-and-ai/models-and-research/gemini-models/gemini-4-argon/\r\n\r\n首发 API 价格 $2/$10 每百万输入/输出 Token ，正式价格翻倍。\r\n\r\n首发群体将包含付费 API 和 Ultra 用户，不包含 Pro 用户。", "content_rendered": "<p>目前未公开发布，只对美国政府和信任测试者提供。</p>\n<p>多个 Benchmark 超过 Opus 5.5：\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/original_images/gemini-4-argon_table_blog.gif\"/></p>\n<p>AAI Index 53 分，介于 GPT 6.1 Sol 和 GPT 6 Astra：\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://pbs.twimg.com/media/HTfY3plasAAay9f?format=jpg&amp;name=large\"/></p>\n<p>Text Arena #1 ，超过 Opus 4.6 ，预计依然会说人话，依然是讨好型人格：\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://pbs.twimg.com/media/HTfdN2Ka4AA3Jdk?format=jpg&amp;name=large\"/></p>\n<p>WebDev Arena #8 ，和 Opus 有较大差距：\n<img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://pbs.twimg.com/media/HTfdNJTbUAAo-l6?format=jpg&amp;name=large\"/></p>\n<p>博客：\n<a href=\"https://blog.google/innovation-and-ai/models-and-research/gemini-models/gemini-4-argon/\" rel=\"nofollow\">https://blog.google/innovation-and-ai/models-and-research/gemini-models/gemini-4-argon/</a></p>\n<p>首发 API 价格 $2/$10 每百万输入/输出 Token ，正式价格翻倍。</p>\n<p>首发群体将包含付费 API 和 Ultra 用户，不包含 Pro 用户。</p>\n", "last_modified": 1790813021, "replies": 20, "id": 1245947}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/f854/54e8/422_large.png?m=1605263518", "name": "browsers", "avatar_normal": "https://cdn.v2ex.com/navatar/f854/54e8/422_normal.png?m=1605263518", "title": "浏览器", "url": "https://www.v2ex.com/go/browsers", "topics": 872, "footer": "", "header": "", "title_alternative": "Browsers", "avatar_mini": "https://cdn.v2ex.com/navatar/f854/54e8/422_mini.png?m=1605263518", "stars": 502, "founder_id": 0, "aliases": [], "root": false, "id": 422, "parent_node_name": "software"}, "member": {"id": 85003, "username": "sudo123", "url": "https://www.v2ex.com/u/sudo123", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/4fd8/dc49/85003_mini.png?m=1467126205", "avatar_normal": "https://cdn.v2ex.com/avatar/4fd8/dc49/85003_normal.png?m=1467126205", "avatar_large": "https://cdn.v2ex.com/avatar/4fd8/dc49/85003_large.png?m=1467126205", "created": 1417594036, "last_modified": 1467126205, "pro": 0}, "last_reply_by": "413420", "last_touched": 1790846166, "title": "最近迁移到 Catsxp 浏览器", "url": "https://www.v2ex.com/t/1245944", "created": 1790811712, "deleted": 0, "content": "从 Brave 切换到 Catsxp 了，主要原因有几点：\r\n\r\n1 、Brave 的本地优化版，作者是中国人。一些小细节优化得比较好，比如垂直标签有树状结构。砍掉了 VPN/AI/钱包功能。AI/翻译功能装个豆包插件就完事。\r\n\r\n2 、自带的翻译功能切换到了谷歌翻译，而不是 brave 翻译。\r\n\r\n3 、密码/书签/扩展程序列表我用插件，不用浏览器自带的功能，可以无痛迁移。\r\n\r\n-密码管理器（本地 Keepass+chromeIPass 浏览器插件）\r\n\r\n-书签及扩展程序列表同步：MarkBridge – Multi-Profile Sync", "content_rendered": "从 Brave 切换到 Catsxp 了，主要原因有几点：<br /><br />1 、Brave 的本地优化版，作者是中国人。一些小细节优化得比较好，比如垂直标签有树状结构。砍掉了 VPN/AI/钱包功能。AI/翻译功能装个豆包插件就完事。<br /><br />2 、自带的翻译功能切换到了谷歌翻译，而不是 brave 翻译。<br /><br />3 、密码/书签/扩展程序列表我用插件，不用浏览器自带的功能，可以无痛迁移。<br /><br />-密码管理器（本地 Keepass+chromeIPass 浏览器插件）<br /><br />-书签及扩展程序列表同步：MarkBridge – Multi-Profile Sync", "last_modified": 1790811794, "replies": 18, "id": 1245944}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/dc56/8979/804_large.png?m=1643850384", "name": "mmm", "avatar_normal": "https://cdn.v2ex.com/navatar/dc56/8979/804_normal.png?m=1643850384", "title": "买买买", "url": "https://www.v2ex.com/go/mmm", "topics": 1271, "footer": "", "header": "如果你最近买了某个有点点奢侈，但是又非常酷的东西，那就发到这个节点来交（xia）流（du）一下吧", "title_alternative": "Buy Buy Buy", "avatar_mini": "https://cdn.v2ex.com/navatar/dc56/8979/804_mini.png?m=1643850384", "stars": 637, "founder_id": 0, "aliases": [], "root": false, "id": 804, "parent_node_name": "internet"}, "member": {"id": 529368, "username": "5xX4U5sUwdELgdQ3", "url": "https://www.v2ex.com/u/5xX4U5sUwdELgdQ3", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/623b3dd4854111bcc66e1254e09bab9d?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/623b3dd4854111bcc66e1254e09bab9d?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/623b3dd4854111bcc66e1254e09bab9d?s=73&d=retro", "created": 1611045571, "last_modified": 1719127258, "pro": 0}, "last_reply_by": "5xX4U5sUwdELgdQ3", "last_touched": 1790836869, "title": "有什么有意思的 3C 产品推荐嘛", "url": "https://www.v2ex.com/t/1245950", "created": 1790814024, "deleted": 0, "content": "最近很想买点有意思的数码产品, 但淘宝京东的推荐算法都很垃圾, 刷了几天都是已经有的/不想要的, 很少有激起\"这个很好玩, 买个玩玩\"想法的东西\r\n\r\n目前已经有的一些有意思的玩意:\r\n\r\n- 两个迷你主机, 装了 pve\r\n- 树莓派 3b,4b,5\r\n- sipeed 的 NanoKVM\r\n- arduino uno, mega, uno q\r\n- stm32 f1, mp1 开发板\r\n- 炬为的 USB PD 分析仪\r\n- usb 数据线引脚通断检测仪\r\n- 带显示屏的 m.2 双协议硬盘盒\r\n- 带显示屏的 sata 接口硬盘盒\r\n- trimui 的复古掌机\r\n\r\n类似的 **500 rmb** 以下小东西有推荐的吗, 因为预算有限, 所以无人机, 相机, 高性能掌机就不考虑了.", "content_rendered": "<p>最近很想买点有意思的数码产品, 但淘宝京东的推荐算法都很垃圾, 刷了几天都是已经有的/不想要的, 很少有激起\"这个很好玩, 买个玩玩\"想法的东西</p>\n<p>目前已经有的一些有意思的玩意:</p>\n<ul>\n<li>两个迷你主机, 装了 pve</li>\n<li>树莓派 3b,4b,5</li>\n<li>sipeed 的 NanoKVM</li>\n<li>arduino uno, mega, uno q</li>\n<li>stm32 f1, mp1 开发板</li>\n<li>炬为的 USB PD 分析仪</li>\n<li>usb 数据线引脚通断检测仪</li>\n<li>带显示屏的 m.2 双协议硬盘盒</li>\n<li>带显示屏的 sata 接口硬盘盒</li>\n<li>trimui 的复古掌机</li>\n</ul>\n<p>类似的 <strong>500 rmb</strong> 以下小东西有推荐的吗, 因为预算有限, 所以无人机, 相机, 高性能掌机就不考虑了.</p>\n", "last_modified": 1790814024, "replies": 18, "id": 1245950}]