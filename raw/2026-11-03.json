[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24732, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3756, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 32079, "username": "losephsky", "url": "https://www.v2ex.com/u/losephsky", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/3d61/b198/32079_mini.png?m=1793603417", "avatar_normal": "https://cdn.v2ex.com/avatar/3d61/b198/32079_normal.png?m=1793603417", "avatar_large": "https://cdn.v2ex.com/avatar/3d61/b198/32079_large.png?m=1793603417", "created": 1357799917, "last_modified": 1793603417, "pro": 0}, "last_reply_by": "newaccount", "last_touched": 1793675402, "title": "前公司老板找我回去救场，情况比较特殊，想听听各位的建议", "url": "https://www.v2ex.com/t/1253836", "created": 1793604456, "deleted": 0, "content": "# 求助：前老板邀约回去救场，想请教大家风险和谈判要点\r\n各位好，想咨询下大家的经验。\r\n\r\n## 背景\r\n我是技术出身的产品经理，之前一手搭建整套产研团队，负责的产品已经多端稳定上线。一个月前正常离职，交接工作当时处理得比较完整。\r\n现在前老板联系我，说产研团队军心涣散、普遍摆烂，项目和系统已经接近系统性崩溃，希望我回去接手稳住局面。\r\n\r\n## 核心顾虑/风险点\r\n1. 公司之前存在晚发薪资+月底缴纳社保的记录；\r\n2. 团队制度近期变动：调整为单休、强抓考勤、新增 KPI ，内部氛围偏向变相倒逼员工主动离职；\r\n3. 角色尴尬：回去后大概率要当“背锅+坏人”，需要推动整改、梳理问题、压进度，很容易和老部下、现有同事形成对立。\r\n\r\n我对之前带出来的团队和产品有感情，但不想踩坑。想请教大家：\r\n\r\n如果考虑回去，在**谈条件、权责边界、劳动合同、风险隔离、团队沟通、止损预案**这些方面，有哪些必须提前敲定、重点留意的事项？\r\n另外也想听听大家判断：这种局面本身值不值得接？\r\n\r\n感谢各位分享经验。", "content_rendered": "<h1>求助：前老板邀约回去救场，想请教大家风险和谈判要点</h1>\n<p>各位好，想咨询下大家的经验。</p>\n<h2>背景</h2>\n<p>我是技术出身的产品经理，之前一手搭建整套产研团队，负责的产品已经多端稳定上线。一个月前正常离职，交接工作当时处理得比较完整。\n现在前老板联系我，说产研团队军心涣散、普遍摆烂，项目和系统已经接近系统性崩溃，希望我回去接手稳住局面。</p>\n<h2>核心顾虑/风险点</h2>\n<ol>\n<li>公司之前存在晚发薪资+月底缴纳社保的记录；</li>\n<li>团队制度近期变动：调整为单休、强抓考勤、新增 KPI ，内部氛围偏向变相倒逼员工主动离职；</li>\n<li>角色尴尬：回去后大概率要当“背锅+坏人”，需要推动整改、梳理问题、压进度，很容易和老部下、现有同事形成对立。</li>\n</ol>\n<p>我对之前带出来的团队和产品有感情，但不想踩坑。想请教大家：</p>\n<p>如果考虑回去，在<strong>谈条件、权责边界、劳动合同、风险隔离、团队沟通、止损预案</strong>这些方面，有哪些必须提前敲定、重点留意的事项？\n另外也想听听大家判断：这种局面本身值不值得接？</p>\n<p>感谢各位分享经验。</p>\n", "last_modified": 1793604456, "replies": 200, "id": 1253836}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 12034, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2544, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 755662, "username": "LessWu", "url": "https://www.v2ex.com/u/LessWu", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/945a812622b7ec505d599bc32eddb40a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/945a812622b7ec505d599bc32eddb40a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/945a812622b7ec505d599bc32eddb40a?s=73&d=retro", "created": 1751538680, "last_modified": 1763606448, "pro": 0}, "last_reply_by": "wakk666", "last_touched": 1793675383, "title": "朋友一家定期献血，我看着矿泉水瓶陷入了沉思", "url": "https://www.v2ex.com/t/1253782", "created": 1793599009, "deleted": 0, "content": "有个朋友在血站工作，听他说，他们家里人都会定期献血。\r\n\r\n这让我有点好奇：以前听人说，定期献血能促进造血，让血液“更新”，对身体有好处；也有人觉得，献血会让身体变虚，需要很久才能恢复。\r\n\r\n这两种说法到底哪个更靠谱？\r\n\r\n我自己一想到一次献血 400 毫升，就有点发怵——差不多是一瓶 500 毫升矿泉水的八成。想象一下从身体里抽出这么多血，总觉得自己可能会头晕 😂\r\n\r\n你献过血吗？一次献了多少？", "content_rendered": "<p>有个朋友在血站工作，听他说，他们家里人都会定期献血。</p>\n<p>这让我有点好奇：以前听人说，定期献血能促进造血，让血液“更新”，对身体有好处；也有人觉得，献血会让身体变虚，需要很久才能恢复。</p>\n<p>这两种说法到底哪个更靠谱？</p>\n<p>我自己一想到一次献血 400 毫升，就有点发怵——差不多是一瓶 500 毫升矿泉水的八成。想象一下从身体里抽出这么多血，总觉得自己可能会头晕 😂</p>\n<p>你献过血吗？一次献了多少？</p>\n", "last_modified": 1793664250, "replies": 150, "id": 1253782}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/1fc2/1400/864_large.png?m=1778522847", "name": "promotions", "avatar_normal": "https://cdn.v2ex.com/navatar/1fc2/1400/864_normal.png?m=1778522847", "title": "推广", "url": "https://www.v2ex.com/go/promotions", "topics": 15033, "footer": "", "header": "来自厂商的推广活动类主题，会被归类到这个节点。希望有情怀的产商们在发布推广内容时，主动选择发布到本节点下。点击 <a href=\"/help/node\">这里</a> 阅读 V2EX 的节点使用指南。", "title_alternative": "Promotions", "avatar_mini": "https://cdn.v2ex.com/navatar/1fc2/1400/864_mini.png?m=1778522847", "stars": 1523, "founder_id": 0, "aliases": [], "root": false, "id": 864, "parent_node_name": ""}, "member": {"id": 359021, "username": "aiwoshishen", "url": "https://www.v2ex.com/u/aiwoshishen", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/8091e88dcbc007237e4d018b4dda9045?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/8091e88dcbc007237e4d018b4dda9045?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/8091e88dcbc007237e4d018b4dda9045?s=73&d=retro", "created": 1540632393, "last_modified": 1751293307, "pro": 0}, "last_reply_by": "ll0421", "last_touched": 1793675375, "title": "[中转站推广] 双 11 活动新用户注册送 10 元", "url": "https://www.v2ex.com/t/1253999", "created": 1793667336, "deleted": 0, "content": "站点： https://onetoken.uk/\r\n\r\n147 个模型，你想要的都有\r\n不降智分组：GPT Pro 满血高智商、gpt-astra 不降智、Codx Pro\r\nDeepSeek 走官方定价 0.2x （峰谷价）\r\n生图 1-4k 一张 $0.04\r\n\r\n本站特色福利分组，opus4.6 满血，0.04x\r\n\r\nhttps://i.imgur.com/132ehPy.png\r\n\r\n留下用户名领鸡蛋。", "content_rendered": "站点： <a target=\"_blank\" href=\"https://onetoken.uk/\" rel=\"nofollow noopener\">https://onetoken.uk/</a><br /><br />147 个模型，你想要的都有<br />不降智分组：GPT Pro 满血高智商、gpt-astra 不降智、Codx Pro<br />DeepSeek 走官方定价 0.2x （峰谷价）<br />生图 1-4k 一张 $0.04<br /><br />本站特色福利分组，opus4.6 满血，0.04x<br /><br /><a target=\"_blank\" href=\"https://i.imgur.com/132ehPy.png\" rel=\"nofollow noopener\" target=\"_blank\"><img src=\"https://i.imgur.com/132ehPy.png\" class=\"embedded_image\" rel=\"noreferrer\"></a><br /><br />留下用户名领鸡蛋。", "last_modified": 1793667336, "replies": 97, "id": 1253999}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_large.png?m=1751736785", "name": "openai", "avatar_normal": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_normal.png?m=1751736785", "title": "OpenAI", "url": "https://www.v2ex.com/go/openai", "topics": 5096, "footer": "", "header": "关于 OpenAI 旗下产品 GPT，DALL·E，和 ChatGPT 的讨论。请不要在 V2EX 的回复中粘贴复制来自 AI 生成的文本。", "title_alternative": "OpenAI", "avatar_mini": "https://cdn.v2ex.com/navatar/fd2c/5e46/1135_mini.png?m=1751736785", "stars": 3430, "founder_id": 0, "aliases": [], "root": false, "id": 1135, "parent_node_name": "geek"}, "member": {"id": 23281, "username": "tcper", "url": "https://www.v2ex.com/u/tcper", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/9691/dfa0/23281_mini.png?m=1742395010", "avatar_normal": "https://cdn.v2ex.com/avatar/9691/dfa0/23281_normal.png?m=1742395010", "avatar_large": "https://cdn.v2ex.com/avatar/9691/dfa0/23281_large.png?m=1742395010", "created": 1341842779, "last_modified": 1742395010, "pro": 0}, "last_reply_by": "Zenyet", "last_touched": 1793675366, "title": "AI 普及之后，应该把所有 Electron 重写为 native", "url": "https://www.v2ex.com/t/1253744", "created": 1793591129, "deleted": 0, "content": "凡是基于 Electron 开发的，开着时间长，必然内存占用越来越大，界面响应越来越慢\r\n\r\n以前大家手写不挑你理，既然 AI 让写代码成本降低了\r\n\r\n感觉第一件事就应该全部迁移为 native\r\n\r\n大不了 macos/windows 各写一套呗，相同业务逻辑", "content_rendered": "<p>凡是基于 Electron 开发的，开着时间长，必然内存占用越来越大，界面响应越来越慢</p>\n<p>以前大家手写不挑你理，既然 AI 让写代码成本降低了</p>\n<p>感觉第一件事就应该全部迁移为 native</p>\n<p>大不了 macos/windows 各写一套呗，相同业务逻辑</p>\n", "last_modified": 1793591186, "replies": 90, "id": 1253744}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 74249, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9817, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 91842, "username": "7RaiNy7", "url": "https://www.v2ex.com/u/7RaiNy7", "website": "", "twitter": "TerryRaiNyLi", "psn": "x_BinaryDevil_x", "github": "BinaryDevil", "btc": "", "location": "Vancouver", "tagline": "Know your limits, and breach them.", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/4cd5/792c/91842_mini.png?m=1793663873", "avatar_normal": "https://cdn.v2ex.com/avatar/4cd5/792c/91842_normal.png?m=1793663873", "avatar_large": "https://cdn.v2ex.com/avatar/4cd5/792c/91842_large.png?m=1793663873", "avatar_xlarge": "https://cdn.v2ex.com/avatar/4cd5/792c/91842_xlarge.png?m=1793663873", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/4cd5/792c/91842_xxlarge.png?m=1793663873", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/4cd5/792c/91842_xxxlarge.png?m=1793663873", "created": 1421235664, "last_modified": 1793663873, "pro": 0}, "last_reply_by": "7RaiNy7", "last_touched": 1793675187, "title": "Claude 不到 10 分钟搓了个这个，码农真的要玩完了", "url": "https://www.v2ex.com/t/1253990", "created": 1793663895, "deleted": 0, "content": "Claude 不到 10 分钟做了个能用的小朋友四则运算练习站，真的感觉要失业了。\r\n\r\nhttps://binarydevil.github.io/bunny-math/\r\n\r\n其实我不是惊讶于他能不能搓到这个程度，而是一把梭 10 分钟就搓出来，完全没有返工。大受震撼", "content_rendered": "Claude 不到 10 分钟做了个能用的小朋友四则运算练习站，真的感觉要失业了。<br /><br /><a target=\"_blank\" href=\"https://binarydevil.github.io/bunny-math/\" rel=\"nofollow noopener\">https://binarydevil.github.io/bunny-math/</a><br /><br />其实我不是惊讶于他能不能搓到这个程度，而是一把梭 10 分钟就搓出来，完全没有返工。大受震撼", "last_modified": 1793663895, "replies": 73, "id": 1253990}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24732, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3756, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 666329, "username": "ghg198964", "url": "https://www.v2ex.com/u/ghg198964", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/e324e206a8a571a2a4e09f076a098333?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/e324e206a8a571a2a4e09f076a098333?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/e324e206a8a571a2a4e09f076a098333?s=73&d=retro", "created": 1702184476, "last_modified": 1793591288, "pro": 0}, "last_reply_by": "bajitanglang", "last_touched": 1793674014, "title": "大龄程序员，备考研究生学 AI", "url": "https://www.v2ex.com/t/1253746", "created": 1793591569, "deleted": 0, "content": "大专毕业到现在写了 10 多年代码了。\r\n明年 12 月我要考计算机研究生。\r\n\r\n我做跨境电商的。今年开始，我几乎不手写代码了。\r\n需求丢进 AI ，代码出来，看一眼，就能上线了。几年后还需要我来看一眼吗？\r\n\r\nAI 之前的软件工程，难如操作系统、浏览器、编译器，我一个都没写过。\r\n但给我时间，我能写出来。至少我知道，它是怎么运转的。\r\n\r\nAI 不一样\r\n我不知道它是怎么实现的。我不知道一堆概率统计，怎么会长出“智能”的。\r\n\r\n打不过就加入，于是我想加入一个实验室去学习。\r\n既是担心未来工作，也是想把“什么是智能”这个问题弄明白\r\n\r\n一年时间，高数线代、408 、英语、政治。有很多东西要学，时间不多了。", "content_rendered": "<p>大专毕业到现在写了 10 多年代码了。\n明年 12 月我要考计算机研究生。</p>\n<p>我做跨境电商的。今年开始，我几乎不手写代码了。\n需求丢进 AI ，代码出来，看一眼，就能上线了。几年后还需要我来看一眼吗？</p>\n<p>AI 之前的软件工程，难如操作系统、浏览器、编译器，我一个都没写过。\n但给我时间，我能写出来。至少我知道，它是怎么运转的。</p>\n<p>AI 不一样\n我不知道它是怎么实现的。我不知道一堆概率统计，怎么会长出“智能”的。</p>\n<p>打不过就加入，于是我想加入一个实验室去学习。\n既是担心未来工作，也是想把“什么是智能”这个问题弄明白</p>\n<p>一年时间，高数线代、408 、英语、政治。有很多东西要学，时间不多了。</p>\n", "last_modified": 1793664418, "replies": 61, "id": 1253746}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 12034, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2544, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 670592, "username": "chawfrank", "url": "https://www.v2ex.com/u/chawfrank", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/eff2005b4d435150c60827318a42849c?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/eff2005b4d435150c60827318a42849c?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/eff2005b4d435150c60827318a42849c?s=73&d=retro", "created": 1704849658, "last_modified": 1793589798, "pro": 0}, "last_reply_by": "ch0sen", "last_touched": 1793635707, "title": "没有在体制内工作的各位，你们还在继续交纳党费吗？", "url": "https://www.v2ex.com/t/1253734", "created": 1793590082, "deleted": 0, "content": "之前想着入党能对找工作及事业有些帮助，但是出社会后，发现如果不在体制内（或在央企、国企内），这个身份没有想象中那么大用处。\r\n\r\n其实当个党员挺好的，无形之中会对自己要求多一些。问题是每年都要给党费，这个有点顶不住，主要是自己的经济也不宽裕……\r\n\r\n你们还在交党费吗？或者说党员给你带来了什么影响？\r\n\r\nPS:我知道有人可能会说党员应该有先进性，不应该为了“好处”而去当党员，但是奈何自己也是个俗人，这就有点像曾小贤之前订的周刊杂志一样", "content_rendered": "之前想着入党能对找工作及事业有些帮助，但是出社会后，发现如果不在体制内（或在央企、国企内），这个身份没有想象中那么大用处。<br /><br />其实当个党员挺好的，无形之中会对自己要求多一些。问题是每年都要给党费，这个有点顶不住，主要是自己的经济也不宽裕……<br /><br />你们还在交党费吗？或者说党员给你带来了什么影响？<br /><br />PS:我知道有人可能会说党员应该有先进性，不应该为了“好处”而去当党员，但是奈何自己也是个俗人，这就有点像曾小贤之前订的周刊杂志一样", "last_modified": 1793590082, "replies": 49, "id": 1253734}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24732, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3756, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 322146, "username": "liubangjie", "url": "https://www.v2ex.com/u/liubangjie", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/e406d47dd4a2dc1377d7ce81056c41f6?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/e406d47dd4a2dc1377d7ce81056c41f6?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/e406d47dd4a2dc1377d7ce81056c41f6?s=73&d=retro", "created": 1528784506, "last_modified": 1528784506, "pro": 0}, "last_reply_by": "still97", "last_touched": 1793658373, "title": "市场行情啥时候能好点？", "url": "https://www.v2ex.com/t/1253887", "created": 1793611263, "deleted": 0, "content": "记得 21 年前，房价年年涨，工资也年年涨，感觉这就是常态，然后突然行情就调转直下了。\r\n\r\n新闻中到处是裁员的新闻，房价连创新低，找工作也越来越不好找，找到了工资比之前还低。。\r\n\r\n大家觉得啥时候是个头啊？啥时候能回到 21 年前的那种状态呢？还能回去吗？", "content_rendered": "<p>记得 21 年前，房价年年涨，工资也年年涨，感觉这就是常态，然后突然行情就调转直下了。</p>\n<p>新闻中到处是裁员的新闻，房价连创新低，找工作也越来越不好找，找到了工资比之前还低。。</p>\n<p>大家觉得啥时候是个头啊？啥时候能回到 21 年前的那种状态呢？还能回去吗？</p>\n", "last_modified": 1793664400, "replies": 46, "id": 1253887}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 242746, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4545, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 575781, "username": "yang0327519", "url": "https://www.v2ex.com/u/yang0327519", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/5ecf/240e/575781_mini.png?m=1770214617", "avatar_normal": "https://cdn.v2ex.com/avatar/5ecf/240e/575781_normal.png?m=1770214617", "avatar_large": "https://cdn.v2ex.com/avatar/5ecf/240e/575781_large.png?m=1770214617", "avatar_xlarge": "https://cdn.v2ex.com/avatar/5ecf/240e/575781_xlarge.png?m=1770214617", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/5ecf/240e/575781_xxlarge.png?m=1770214617", "created": 1647483867, "last_modified": 1770214617, "pro": 0}, "last_reply_by": "MYDB", "last_touched": 1793675321, "title": "如何找借口拒绝医生开的中药", "url": "https://www.v2ex.com/t/1254023", "created": 1793670417, "deleted": 0, "content": "如题，特别是那种说明书上各种“尚不明确”的中药\r\n\r\n怎么才能不得罪大夫的情况下，合理的拒绝", "content_rendered": "<p>如题，特别是那种说明书上各种“尚不明确”的中药</p>\n<p>怎么才能不得罪大夫的情况下，合理的拒绝</p>\n", "last_modified": 1793670417, "replies": 45, "id": 1254023}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/3cef/96dc/949_large.png?m=1730363795", "name": "nas", "avatar_normal": "https://cdn.v2ex.com/navatar/3cef/96dc/949_normal.png?m=1730363795", "title": "NAS", "url": "https://www.v2ex.com/go/nas", "topics": 3315, "footer": "", "header": "关于网络存储设备的讨论", "title_alternative": "NAS", "avatar_mini": "https://cdn.v2ex.com/navatar/3cef/96dc/949_mini.png?m=1730363795", "stars": 3109, "founder_id": 0, "aliases": [], "root": false, "id": 949, "parent_node_name": "hardware"}, "member": {"id": 326767, "username": "u2gign", "url": "https://www.v2ex.com/u/u2gign", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/ac7584fc12ef20ff9fa815929c1ac7f9?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/ac7584fc12ef20ff9fa815929c1ac7f9?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/ac7584fc12ef20ff9fa815929c1ac7f9?s=73&d=retro", "created": 1530683907, "last_modified": 1793600326, "pro": 0}, "last_reply_by": "jonsmith", "last_touched": 1793634166, "title": "周末白裙被勒索病毒攻击，目前恢复中", "url": "https://www.v2ex.com/t/1253811", "created": 1793601815, "deleted": 0, "content": "周末起来发现 nas 服务都挂了，查看日志显示凌晨 2 点多被攻击，幸好 nas 还能通过 5001 端口登入，所有文件都被加密，后缀是.L0CK3D ，问了下 muse,按照提示进行操作，后面让 muse 通过 tailscale 来接管操作，关键千万不能关机。找到密钥以后就简单了，后面就是慢慢跑脚本恢复了。\r\n[![pngdLpF.md.png]( https://s41.ax1x.com/2026/11/02/pngdLpF.md.png)]( https://imgchr.com/i/pngdLpF)\r\n[![pngdoT0.md.png]( https://s41.ax1x.com/2026/11/02/pngdoT0.md.png)]( https://imgchr.com/i/pngdoT0)\r\n[![pngd7kV.md.png]( https://s41.ax1x.com/2026/11/02/pngd7kV.md.png)]( https://imgchr.com/i/pngd7kV)\r\n[![pngdIwq.md.png]( https://s41.ax1x.com/2026/11/02/pngdIwq.md.png)]( https://imgchr.com/i/pngdIwq)\r\n[![pngdHYT.md.png]( https://s41.ax1x.com/2026/11/02/pngdHYT.md.png)]( https://imgchr.com/i/pngdHYT)\r\n[![pngdbfU.md.png]( https://s41.ax1x.com/2026/11/02/pngdbfU.md.png)]( https://imgchr.com/i/pngdbfU)", "content_rendered": "<p>周末起来发现 nas 服务都挂了，查看日志显示凌晨 2 点多被攻击，幸好 nas 还能通过 5001 端口登入，所有文件都被加密，后缀是.L0CK3D ，问了下 muse,按照提示进行操作，后面让 muse 通过 tailscale 来接管操作，关键千万不能关机。找到密钥以后就简单了，后面就是慢慢跑脚本恢复了。\n<a href=\"https://imgchr.com/i/pngdLpF\" rel=\"nofollow\"><img alt=\"pngdLpF.md.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s41.ax1x.com/2026/11/02/pngdLpF.md.png\"/></a>\n<a href=\"https://imgchr.com/i/pngdoT0\" rel=\"nofollow\"><img alt=\"pngdoT0.md.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s41.ax1x.com/2026/11/02/pngdoT0.md.png\"/></a>\n<a href=\"https://imgchr.com/i/pngd7kV\" rel=\"nofollow\"><img alt=\"pngd7kV.md.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s41.ax1x.com/2026/11/02/pngd7kV.md.png\"/></a>\n<a href=\"https://imgchr.com/i/pngdIwq\" rel=\"nofollow\"><img alt=\"pngdIwq.md.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s41.ax1x.com/2026/11/02/pngdIwq.md.png\"/></a>\n<a href=\"https://imgchr.com/i/pngdHYT\" rel=\"nofollow\"><img alt=\"pngdHYT.md.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s41.ax1x.com/2026/11/02/pngdHYT.md.png\"/></a>\n<a href=\"https://imgchr.com/i/pngdbfU\" rel=\"nofollow\"><img alt=\"pngdbfU.md.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s41.ax1x.com/2026/11/02/pngdbfU.md.png\"/></a></p>\n", "last_modified": 1793601815, "replies": 43, "id": 1253811}]