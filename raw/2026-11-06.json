[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_large.png?m=1630643913", "name": "apple", "avatar_normal": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_normal.png?m=1630643913", "title": "Apple", "url": "https://www.v2ex.com/go/apple", "topics": 31421, "footer": "", "header": "设计了 <a href=\"/go/watch\">Apple Watch</a>，<a href=\"/go/ipad\">iPad</a>，<a href=\"/go/iphone\">iPhone</a>，<a href=\"/go/imac\">iMac</a> 及 <a href=\"/go/mbp\">MacBook Pro</a> 等电子产品的美国公司。", "title_alternative": "Apple", "avatar_mini": "https://cdn.v2ex.com/navatar/6cdd/60ea/184_mini.png?m=1630643913", "stars": 3373, "founder_id": 0, "aliases": [], "root": false, "id": 184, "parent_node_name": "hardware"}, "member": {"id": 361558, "username": "ilaw", "url": "https://www.v2ex.com/u/ilaw", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/2e3c989fb350d2ac9c5030ed968900ce?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/2e3c989fb350d2ac9c5030ed968900ce?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/2e3c989fb350d2ac9c5030ed968900ce?s=73&d=retro", "created": 1541591554, "last_modified": 1541591554, "pro": 0}, "last_reply_by": "yh7gdiaYW", "last_touched": 1793933597, "title": "彩云天气是不是快倒闭了？", "url": "https://www.v2ex.com/t/1254663", "created": 1793849061, "deleted": 0, "content": "彩云天气 pro 的广告多的离谱，体验及其糟糕\n早些年购买了彩云天气 Pro 版，近几年这款 App 的广告越来越多，多到离谱，十次打开八次都有弹窗广告。App 也越来越大了，我只是一个普通用户，根本不需要那么丰富详尽的数据。\n还没买 Pro 版的就别买了，强烈不推荐。", "content_rendered": "<p>彩云天气 pro 的广告多的离谱，体验及其糟糕\n早些年购买了彩云天气 Pro 版，近几年这款 App 的广告越来越多，多到离谱，十次打开八次都有弹窗广告。App 也越来越大了，我只是一个普通用户，根本不需要那么丰富详尽的数据。\n还没买 Pro 版的就别买了，强烈不推荐。</p>\n", "last_modified": 1793849061, "replies": 80, "id": 1254663}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", 