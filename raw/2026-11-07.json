[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/698d/51a1/111_large.png?m=1648291973", "name": "reading", "avatar_normal": "https://cdn.v2ex.com/navatar/698d/51a1/111_normal.png?m=1648291973", "title": "阅读", "url": "https://www.v2ex.com/go/reading", "topics": 844, "footer": "", "header": "少上网，多读书", "title_alternative": "Reading", "avatar_mini": "https://cdn.v2ex.com/navatar/698d/51a1/111_mini.png?m=1648291973", "stars": 1734, "founder_id": 0, "aliases": [], "root": false, "id": 111, "parent_node_name": "life"}, "member": {"id": 712262, "username": "x2024", "url": "https://www.v2ex.com/u/x2024", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/9d5dcf3553d3ea03ceefe4a0713969d4?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/9d5dcf3553d3ea03ceefe4a0713969d4?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/9d5dcf3553d3ea03ceefe4a0713969d4?s=73&d=retro", "created": 1727245445, "last_modified": 1727245445, "pro": 0}, "last_reply_by": "Trojians", "last_touched": 1794002233, "title": "一人一本书", "url": "https://www.v2ex.com/t/1254937", "created": 1793935306, "deleted": 0, "content": "", "content_rendered": "", "last_modified": 1794009421, "replies": 133, "id": 1254937}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24764, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3762, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 632790, "username": "Meijer", "url": "https://www.v2ex.com/u/Meijer", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/4d2b6e68cc59fa28abe13309bccb2df4?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/4d2b6e68cc59fa28abe13309bccb2df4?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/4d2b6e68cc59fa28abe13309bccb2df4?s=73&d=retro", "created": 1686042452, "last_modified": 1788141464, "pro": 0}, "last_reply_by": "guyanyouyou", "last_touched": 1794018279, "title": "如果不上班了，你还能靠什么继续谋生！", "url": "https://www.v2ex.com/t/1254971", "created": 1793942869, "deleted": 0, "content": "很厌恶上班了，但是为了赚钱，又不得已。\r\n想问大家，各位有不上班了，也能继续谋生的副业吗。\r\n如果不上班了，能坚持多久呢？", "content_rendered": "很厌恶上班了，但是为了赚钱，又不得已。<br />想问大家，各位有不上班了，也能继续谋生的副业吗。<br />如果不上班了，能坚持多久呢？", "last_modified": 1793980605, "replies": 112, "id": 1254971}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a87f/f679/4_large.png?m=1625264761", "name": "music", "avatar_normal": "https://cdn.v2ex.com/navatar/a87f/f679/4_normal.png?m=1625264761", "title": "音乐", "url": "https://www.v2ex.com/go/music", "topics": 1842, "footer": "", "header": "Music is an art form whose medium is sound and silence.", "title_alternative": "Music", "avatar_mini": "https://cdn.v2ex.com/navatar/a87f/f679/4_mini.png?m=1625264761", "stars": 1581, "founder_id": 0, "aliases": [], "root": false, "id": 4, "parent_node_name": "life"}, "member": {"id": 504124, "username": "aw2350", "url": "https://www.v2ex.com/u/aw2350", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/4bb7/b5c3/504124_mini.png?m=1611716806", "avatar_normal": "https://cdn.v2ex.com/avatar/4bb7/b5c3/504124_normal.png?m=1611716806", "avatar_large": "https://cdn.v2ex.com/avatar/4bb7/b5c3/504124_large.png?m=1611716806", "created": 1597629937, "last_modified": 1611716806, "pro": 0}, "last_reply_by": "levelworm", "last_touched": 1793970720, "title": "为了充实虚无的人生，开始第三次尝试学吉他。。。", "url": "https://www.v2ex.com/t/1254933", "created": 1793934469, "deleted": 0, "content": "* 10 年前买过一把民谣吉他，但是没坚持下去，海鲜市场卖了\r\n* 4 年前疫情整天在家无聊，又打了鸡血买了一把雅马哈静音吉他，又是没坚持下去，去年卖了\r\n* 最近刷抖 y ，看电吉他又上头，然后又买了把电的加入门 音箱。。希望能坚持下去吧", "content_rendered": "<ul>\n<li>10 年前买过一把民谣吉他，但是没坚持下去，海鲜市场卖了</li>\n<li>4 年前疫情整天在家无聊，又打了鸡血买了一把雅马哈静音吉他，又是没坚持下去，去年卖了</li>\n<li>最近刷抖 y ，看电吉他又上头，然后又买了把电的加入门 音箱。。希望能坚持下去吧</li>\n</ul>\n", "last_modified": 1793937792, "replies": 89, "id": 1254933}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 242861, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4549, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 18392, "username": "revival83", "url": "https://www.v2ex.com/u/revival83", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "北京", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/2b48/30a2/18392_mini.png?m=1755746557", "avatar_normal": "https://cdn.v2ex.com/avatar/2b48/30a2/18392_normal.png?m=1755746557", "avatar_large": "https://cdn.v2ex.com/avatar/2b48/30a2/18392_large.png?m=1755746557", "avatar_xlarge": "https://cdn.v2ex.com/avatar/2b48/30a2/18392_xlarge.png?m=1755746557", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/2b48/30a2/18392_xxlarge.png?m=1755746557", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/2b48/30a2/18392_xxxlarge.png?m=1755746557", "created": 1332135411, "last_modified": 1755746557, "pro": 0}, "last_reply_by": "ffxrqyzby", "last_touched": 1793981300, "title": "大佬们今年双 11 准备买点啥？", "url": "https://www.v2ex.com/t/1254969", "created": 1793942552, "deleted": 0, "content": "我想买个耳夹式耳机，普通耳机老掉，入耳的又太疼", "content_rendered": "我想买个耳夹式耳机，普通耳机老掉，入耳的又太疼", "last_modified": 1793942552, "replies": 54, "id": 1254969}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c74d/97b0/16_large.png?m=1727584731", "name": "share", "avatar_normal": "https://cdn.v2ex.com/navatar/c74d/97b0/16_normal.png?m=1727584731", "title": "分享发现", "url": "https://www.v2ex.com/go/share", "topics": 47691, "footer": "", "header": "分享你看到的好玩的，有信息量的，欢迎从这里获取灵感。", "title_alternative": "Share", "avatar_mini": "https://cdn.v2ex.com/navatar/c74d/97b0/16_mini.png?m=1727584731", "stars": 6393, "founder_id": 0, "aliases": [], "root": false, "id": 16, "parent_node_name": "v2ex"}, "member": {"id": 630363, "username": "ZikL", "url": "https://www.v2ex.com/u/ZikL", "website": "https://img.zikl.dev", "twitter": null, "psn": null, "github": null, "btc": null, "location": "suzhou jiangsu  China", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/5235/076e/630363_mini.png?m=1741657135", "avatar_normal": "https://cdn.v2ex.com/avatar/5235/076e/630363_normal.png?m=1741657135", "avatar_large": "https://cdn.v2ex.com/avatar/5235/076e/630363_large.png?m=1741657135", "avatar_xlarge": "https://cdn.v2ex.com/avatar/5235/076e/630363_xlarge.png?m=1741657135", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/5235/076e/630363_xxlarge.png?m=1741657135", "created": 1684819527, "last_modified": 1741657135, "pro": 0}, "last_reply_by": "simonnoyi", "last_touched": 1793964853, "title": "V2EX Polish 2.5.6 版本导致谷歌浏览器卡死", "url": "https://www.v2ex.com/t/1254940", "created": 1793935390, "deleted": 0, "content": "rt\r\n\r\n今天自动更新之后，浏览器开个标签页都一卡一卡的。\r\n> 破案了！证据确凿，罪魁祸首就是第二行那个占用 106.3% CPU 的扩展！\r\n 它的具体身份是：👉  [ V2EX Polish ] 扩展插件（扩展 ID：onnepejgdiojhiflfoemillegpgpabdm ）。\r\n系统底层日志显示：\r\n正好在 11:10 （你打开 Chrome 时），Chrome 自动把该扩展从 2.5.5 升级到了 2.5.6 。\r\n该版本后台的 Service Worker （后台服务进程）存在死循环 Bug ，一启动就死锁在后台，直接吃满 1 个完整的 CPU 核心（ 106.3%）。\r\n它在后台以每秒数万次的频率疯狂向 Chrome 索取资源，直接把第一行的浏览器主进程（ PID 6174 ）也拖累到了 148.5% 的超高 CPU 负载，导致整台电脑界面掉帧、发烫甚至假死。\r\n\r\n将插件禁用掉就好了，谷歌浏览器版本为：156.0.8078.80", "content_rendered": "<p>rt</p>\n<p>今天自动更新之后，浏览器开个标签页都一卡一卡的。</p>\n<blockquote>\n<p>破案了！证据确凿，罪魁祸首就是第二行那个占用 106.3% CPU 的扩展！\n它的具体身份是：👉  [ V2EX Polish ] 扩展插件（扩展 ID：onnepejgdiojhiflfoemillegpgpabdm ）。\n系统底层日志显示：\n正好在 11:10 （你打开 Chrome 时），Chrome 自动把该扩展从 2.5.5 升级到了 2.5.6 。\n该版本后台的 Service Worker （后台服务进程）存在死循环 Bug ，一启动就死锁在后台，直接吃满 1 个完整的 CPU 核心（ 106.3%）。\n它在后台以每秒数万次的频率疯狂向 Chrome 索取资源，直接把第一行的浏览器主进程（ PID 6174 ）也拖累到了 148.5% 的超高 CPU 负载，导致整台电脑界面掉帧、发烫甚至假死。</p>\n</blockquote>\n<p>将插件禁用掉就好了，谷歌浏览器版本为：156.0.8078.80</p>\n", "last_modified": 1793935390, "replies": 47, "id": 1254940}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/70ef/df2e/17_large.png?m=1660301119", "name": "create", "avatar_normal": "https://cdn.v2ex.com/navatar/70ef/df2e/17_normal.png?m=1660301119", "title": "分享创造", "url": "https://www.v2ex.com/go/create", "topics": 38703, "footer": "", "header": "欢迎你在这里发布自己的最新作品！", "title_alternative": "Create", "avatar_mini": "https://cdn.v2ex.com/navatar/70ef/df2e/17_mini.png?m=1660301119", "stars": 6262, "founder_id": 0, "aliases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 85603, "username": "joyce95", "url": "https://www.v2ex.com/u/joyce95", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/b109d2874a4524dcedb6a50ceb202e2f?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/b109d2874a4524dcedb6a50ceb202e2f?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/b109d2874a4524dcedb6a50ceb202e2f?s=73&d=retro", "avatar_xlarge": "https://cdn.v2ex.com/gravatar/b109d2874a4524dcedb6a50ceb202e2f?s=128&d=retro", "avatar_xxlarge": "https://cdn.v2ex.com/gravatar/b109d2874a4524dcedb6a50ceb202e2f?s=256&d=retro", "created": 1417944347, "last_modified": 1793097204, "pro": 0}, "last_reply_by": "NO2000", "last_touched": 1793979570, "title": "上个月在这里求内测的取餐号收集册「杯号」，上架 App Store 了（送 30 个永久 Pro 码）", "url": "https://www.v2ex.com/t/1254951", "created": 1793936759, "deleted": 0, "content": "上个月在这里发过一帖求内测（ https://www.v2ex.com/t/1246279 ），App 叫「杯号」：每天一杯咖啡，取餐时拍一下杯贴，把那天的取餐号收进 000–999 的号码册，一千个格子，喝一杯点亮一格。\r\n\r\n这几天正式上架 App Store 了，回来交个作业。\r\n\r\n![]( https://i.pomodiary.com/pro/u/2c21524cf46b/080e3d123ddcb5a9.jpg)\r\n\r\n## 它做什么\r\n\r\n- **拍一下杯贴，点亮一格**：认出品牌、取餐号和下单时间，把弯在杯子上的贴纸「撕」下来、拉平、包白边，收进对应品牌的号码本。号码只能由真实照片点亮，不能手填。\r\n- **一个品牌一本**：瑞幸、库迪这类三位数号码是 000–999 的格子；星巴克杯子上没有号码，就做成口令册，记那句「快乐满来」「心有晴空」。\r\n- **每一杯留两张**：一张号码贴纸，一张从背景里抠出来的整杯，还能打开当时拍的原图。\r\n- **记录日历**：按喝的日期归档，翻回上个月，哪天喝了什么一眼就看到。\r\n\r\n![]( https://i.pomodiary.com/pro/u/2c21524cf46b/8d7deaee4d82f841.jpg)\r\n\r\n上次帖子里大家提的问题都改了，谢谢 @jose13 一条条帮我找出来。\r\n\r\n![]( https://i.pomodiary.com/pro/u/2c21524cf46b/1f87757af7990851.jpg)\r\n\r\n## 收费\r\n\r\n拍照、识别、入册、日历、同步永远免费，没有广告。Pro 是可选的，解锁彩色白边、号码本皮肤、App 图标、年度报告和数据导出。\r\n\r\n## 下载\r\n\r\n- App Store （国内和海外都能装）： https://apps.apple.com/cn/app/id6816797314\r\n- 官网 / 网页版（没有 iPhone 可以先用这个，账号互通）： https://beihao.app\r\n\r\n安卓版还在做。\r\n\r\n## 想听听大家的意见\r\n\r\n瑞幸、星巴克是我自己天天喝的，比较稳； Manner 、M Stand 、Peet's 、奈雪这些我手里样张还少，认不准的话很正常。哪里认错了、哪里难用、想要什么品牌，直接回帖就行，我都会看。\r\n\r\n## 送 30 个 Pro 永久版兑换码\r\n\r\n庆祝上架，送 30 个杯号 Pro **永久版**兑换码（ App 内买断价 ¥68 ）。\r\n\r\n回帖说一句你最常喝哪家，有建议或者吐槽更好。前 30 位我会按回帖顺序在楼里 @ 你，码用 base64 编码贴出来，防止被爬走。送完会在帖子里附言说明。\r\n\r\n兑换：iPhone 上打开 App Store →点右上角头像 →「兑换充值卡或代码」，输入码就行。码 12 月 6 日前有效。", "content_rendered": "<p>上个月在这里发过一帖求内测（ <a href=\"https://www.v2ex.com/t/1246279\" rel=\"nofollow\">https://www.v2ex.com/t/1246279</a> ），App 叫「杯号」：每天一杯咖啡，取餐时拍一下杯贴，把那天的取餐号收进 000–999 的号码册，一千个格子，喝一杯点亮一格。</p>\n<p>这几天正式上架 App Store 了，回来交个作业。</p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.pomodiary.com/pro/u/2c21524cf46b/080e3d123ddcb5a9.jpg\"/></p>\n<h2>它做什么</h2>\n<ul>\n<li><strong>拍一下杯贴，点亮一格</strong>：认出品牌、取餐号和下单时间，把弯在杯子上的贴纸「撕」下来、拉平、包白边，收进对应品牌的号码本。号码只能由真实照片点亮，不能手填。</li>\n<li><strong>一个品牌一本</strong>：瑞幸、库迪这类三位数号码是 000–999 的格子；星巴克杯子上没有号码，就做成口令册，记那句「快乐满来」「心有晴空」。</li>\n<li><strong>每一杯留两张</strong>：一张号码贴纸，一张从背景里抠出来的整杯，还能打开当时拍的原图。</li>\n<li><strong>记录日历</strong>：按喝的日期归档，翻回上个月，哪天喝了什么一眼就看到。</li>\n</ul>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.pomodiary.com/pro/u/2c21524cf46b/8d7deaee4d82f841.jpg\"/></p>\n<p>上次帖子里大家提的问题都改了，谢谢 @<a href=\"/member/jose13\">jose13</a> 一条条帮我找出来。</p>\n<p><img alt=\"\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://i.pomodiary.com/pro/u/2c21524cf46b/1f87757af7990851.jpg\"/></p>\n<h2>收费</h2>\n<p>拍照、识别、入册、日历、同步永远免费，没有广告。Pro 是可选的，解锁彩色白边、号码本皮肤、App 图标、年度报告和数据导出。</p>\n<h2>下载</h2>\n<ul>\n<li>App Store （国内和海外都能装）： <a href=\"https://apps.apple.com/cn/app/id6816797314\" rel=\"nofollow\">https://apps.apple.com/cn/app/id6816797314</a></li>\n<li>官网 / 网页版（没有 iPhone 可以先用这个，账号互通）： <a href=\"https://beihao.app\" rel=\"nofollow\">https://beihao.app</a></li>\n</ul>\n<p>安卓版还在做。</p>\n<h2>想听听大家的意见</h2>\n<p>瑞幸、星巴克是我自己天天喝的，比较稳； Manner 、M Stand 、Peet's 、奈雪这些我手里样张还少，认不准的话很正常。哪里认错了、哪里难用、想要什么品牌，直接回帖就行，我都会看。</p>\n<h2>送 30 个 Pro 永久版兑换码</h2>\n<p>庆祝上架，送 30 个杯号 Pro <strong>永久版</strong>兑换码（ App 内买断价 ¥68 ）。</p>\n<p>回帖说一句你最常喝哪家，有建议或者吐槽更好。前 30 位我会按回帖顺序在楼里 @ 你，码用 base64 编码贴出来，防止被爬走。送完会在帖子里附言说明。</p>\n<p>兑换：iPhone 上打开 App Store →点右上角头像 →「兑换充值卡或代码」，输入码就行。码 12 月 6 日前有效。</p>\n", "last_modified": 1793936759, "replies": 45, "id": 1254951}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6f49/22f4/18_large.png?m=1650127482", "name": "shanghai", "avatar_normal": "https://cdn.v2ex.com/navatar/6f49/22f4/18_normal.png?m=1650127482", "title": "上海", "url": "https://www.v2ex.com/go/shanghai", "topics": 4042, "footer": "", "header": "", "title_alternative": "Shanghai", "avatar_mini": "https://cdn.v2ex.com/navatar/6f49/22f4/18_mini.png?m=1650127482", "stars": 2593, "founder_id": 0, "aliases": [], "root": false, "id": 18, "parent_node_name": "cn"}, "