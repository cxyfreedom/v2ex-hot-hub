[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24847, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3769, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 195347, "username": "121819756", "url": "https://www.v2ex.com/u/121819756", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/2e9b057b28d7d81dfaaf88a4d1711f0b?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/2e9b057b28d7d81dfaaf88a4d1711f0b?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/2e9b057b28d7d81dfaaf88a4d1711f0b?s=73&d=retro", "created": 1476065068, "last_modified": 1687244463, "pro": 0}, "last_reply_by": "BreakTheBank", "last_touched": 1794766174, "title": "世态炎凉，瑟瑟发抖", "url": "https://www.v2ex.com/t/1257325", "created": 1794795319, "deleted": 0, "content": "纯吐槽\r\n\r\n每次周一开会都很想打开 boss 准备简历了，但是感觉实在是难啊\r\n\r\n会上交流的时候发现，越菜的人越依赖 ai，越觉得 ai 好用，直接来一句开发效率提高 100%，给我人都听傻了，(不是说 ai 不好用，只能说你不测试不看代码逻辑的话，那可以到 100%\r\n\r\n现在问同事之前他写的逻辑，他都直接来一句你让 ai 分析总结一下，我就很无语了\r\n\r\n开发一个 skill 就想完美使用，用下来发现甚至是 debuff，还不如不走 skill\r\n\r\n没有一个真正技术大佬的坐镇，是真的好难啊，乱七八糟的管理，现在直接没测试，发现好几次同事写的东西都跑不通就上线了，人也是麻了。\r\n\r\n后面还要转 FDE（本质外包驻场，一点意思没有", "content_rendered": "纯吐槽<br /><br />每次周一开会都很想打开 boss 准备简历了，但是感觉实在是难啊<br /><br />会上交流的时候发现，越菜的人越依赖 ai，越觉得 ai 好用，直接来一句开发效率提高 100%，给我人都听傻了，(不是说 ai 不好用，只能说你不测试不看代码逻辑的话，那可以到 100%<br /><br />现在问同事之前他写的逻辑，他都直接来一句你让 ai 分析总结一下，我就很无语了<br /><br />开发一个 skill 就想完美使用，用下来发现甚至是 debuff，还不如不走 skill<br /><br />没有一个真正技术大佬的坐镇，是真的好难啊，乱七八糟的管理，现在直接没测试，发现好几次同事写的东西都跑不通就上线了，人也是麻了。<br /><br />后面还要转 FDE（本质外包驻场，一点意思没有", "last_modified": 1794795319, "replies": 153, "id": 1257325}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 74470, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9830, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 644855, "username": "burnsby", "url": "https://www.v2ex.com/u/burnsby", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/b9f9fc4b4f949b7aa6d10cc37c9e2dfe?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/b9f9fc4b4f949b7aa6d10cc37c9e2dfe?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/b9f9fc4b4f949b7aa6d10cc37c9e2dfe?s=73&d=retro", "created": 1692696996, "last_modified": 1786600360, "pro": 0}, "last_reply_by": "baizheng", "last_touched": 1794826619, "title": "其实我个人也是比较偏向于使用国模的，但问题是", "url": "https://www.v2ex.com/t/1257339", "created": 1794796677, "deleted": 0, "content": "其实我个人也是比较偏向于使用国模的，但问题是：\r\n\r\n- 要不像 deepseek 这种没有订阅的，使用起来其实非常昂贵的，你用 flash, 一天很容易烧掉 100 块\r\n- 要不像 GLM 这种的，在模型能力不行的情况下（最近降智特别严重），同时还慢、贵，现在 GLM 5.5 更是难产\r\n- 要不像 KIMI 这种的，模型能力不错，但是更贵、更慢、输入输出不透明\r\n- 其它的就是一坨\r\n\r\n我当然不想用国外的模型，因为同样恶心：\r\n\r\n- gpt 之前经常重置，但是使用政策朝令夕改，模型降智那也是常有的事，也就发布之初使用体验最好\r\n- claude 使用起来最为稳定，但是仇视中国人，疯狂封号，使用之外的事情非常折腾，而且也是如履薄冰\r\n- gemini 被戏称北美豆包，从去年 12 月份起， antigravity 到今年 9 月份才勉强能用，多少人被 gemini 3 pro 的刷分和 pro 半价订阅骗去订阅了\r\n\r\n说到底，用户只想用高性价比的模型，不要求你能力最高，但是也不能在模型能力不足的同时，价格还要赶超吧？  而且是在国内消费能力明显比米国低的情况下！\r\n\r\n贵而好、便宜单一般、又贵又不好，用户会用脚投票", "content_rendered": "其实我个人也是比较偏向于使用国模的，但问题是：<br /><br />- 要不像 deepseek 这种没有订阅的，使用起来其实非常昂贵的，你用 flash, 一天很容易烧掉 100 块<br />- 要不像 GLM 这种的，在模型能力不行的情况下（最近降智特别严重），同时还慢、贵，现在 GLM 5.5 更是难产<br />- 要不像 KIMI 这种的，模型能力不错，但是更贵、更慢、输入输出不透明<br />- 其它的就是一坨<br /><br />我当然不想用国外的模型，因为同样恶心：<br /><br />- gpt 之前经常重置，但是使用政策朝令夕改，模型降智那也是常有的事，也就发布之初使用体验最好<br />- claude 使用起来最为稳定，但是仇视中国人，疯狂封号，使用之外的事情非常折腾，而且也是如履薄冰<br />- gemini 被戏称北美豆包，从去年 12 月份起， antigravity 到今年 9 月份才勉强能用，多少人被 gemini 3 pro 的刷分和 pro 半价订阅骗去订阅了<br /><br />说到底，用户只想用高性价比的模型，不要求你能力最高，但是也不能在模型能力不足的同时，价格还要赶超吧？  而且是在国内消费能力明显比米国低的情况下！<br /><br />贵而好、便宜单一般、又贵又不好，用户会用脚投票", "last_modified": 1794796677, "replies": 135, "id": 1257339}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a87f/f679/4_large.png?m=1625264761", "name": "music", "avatar_normal": "https://cdn.v2ex.com/navatar/a87f/f679/4_normal.png?m=1625264761", "title": "音乐", "url": "https://www.v2ex.com/go/music", "topics": 1844, "footer": "", "header": "Music is an art form whose medium is sound and silence.", "title_alternative": "Music", "avatar_mini": "https://cdn.v2ex.com/navatar/a87f/f679/4_mini.png?m=1625264761", "stars": 1582, "founder_id": 0, "aliases": [], "root": false, "id": 4, "parent_node_name": "life"}, "member": {"id": 308864, "username": "lizhesystem", "url": "https://www.v2ex.com/u/lizhesystem", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/4c8a/3107/308864_mini.png?m=1781494372", "avatar_normal": "https://cdn.v2ex.com/avatar/4c8a/3107/308864_normal.png?m=1781494372", "avatar_large": "https://cdn.v2ex.com/avatar/4c8a/3107/308864_large.png?m=1781494372", "avatar_xlarge": "https://cdn.v2ex.com/avatar/4c8a/3107/308864_xlarge.png?m=1781494372", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/4c8a/3107/308864_xxlarge.png?m=1781494372", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/4c8a/3107/308864_xxxlarge.png?m=1781494372", "created": 1523786008, "last_modified": 1781494372, "pro": 0}, "last_reply_by": "junie365", "last_touched": 1794831010, "title": "唉，QQ 音乐年会员又涨价了", "url": "https://www.v2ex.com/t/1257321", "created": 1794794773, "deleted": 0, "content": "每年都是趁着 11 月份生日的时候续费年会员，想着有优惠，昨天一看年卡变成 128 了，记得前几年好像 80+，去年买的好像 90 多。", "content_rendered": "<p>每年都是趁着 11 月份生日的时候续费年会员，想着有优惠，昨天一看年卡变成 128 了，记得前几年好像 80+，去年买的好像 90 多。</p>\n", "last_modified": 1794796427, "replies": 82, "id": 1257321}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6f49/22f4/18_large.png?m=1650127482", "name": "shanghai", "avatar_normal": "https://cdn.v2ex.com/navatar/6f49/22f4/18_normal.png?m=1650127482", "title": "上海", "url": "https://www.v2ex.com/go/shanghai", "topics": 4046, "footer": "", "header": "", "title_alternative": "Shanghai", "avatar_mini": "https://cdn.v2ex.com/navatar/6f49/22f4/18_mini.png?m=1650127482", "stars": 2594, "founder_id": 0, "aliases": [], "root": false, "id": 18, "parent_node_name": "cn"}, "member": {"id": 346240, "username": "supuwoerc", "url": "https://www.v2ex.com/u/supuwoerc", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "北京", "tagline": "", "bio": "beijingbeijing", "avatar_mini": "https://cdn.v2ex.com/avatar/3da5/e050/346240_mini.png?m=1756951017", "avatar_normal": "https://cdn.v2ex.com/avatar/3da5/e050/346240_normal.png?m=1756951017", "avatar_large": "https://cdn.v2ex.com/avatar/3da5/e050/346240_large.png?m=1756951017", "created": 1535763740, "last_modified": 1756951017, "pro": 0}, "last_reply_by": "Orange2269", "last_touched": 1794829289, "title": "路上天天都能遇到焊颈帝", "url": "https://www.v2ex.com/t/1257304", "created": 1794793155, "deleted": 0, "content": "提车半年，每天通勤 13 公里，早上 5 公里，晚上走高架 8 公里，虽说晚上距离远点而且上海南北高架很堵，但是开起来都比早上轻松太多了...\r\n\r\n几乎每天路上都能遇到电动车和自行车乱骑的，转弯回头观察也不会，电动车转向灯也没有，反正就是突然就要顶你车头前面转弯...\r\n\r\n早上又遇到一个大妈，我直行过 T 字路口速度降低到 20 就是怕电动车来个转弯，果不其然大妈一个左转直接顶我车头前面，给我吓得一把方向加急刹才停下，大妈挡风被贴着车屁股过去了，更恶心的是我到公司翻看记录仪，我后车也遇到了 A 柱盲区的电动车，我车刚停下电动车就往我车屁股和他车头的缝里钻，他刚起步又是一脚急刹，估计也是吓坏了...\r\n\r\n碰到了机动车高低是个次责，和同事吐槽，同事说被判过次责，电动车主责赔了 1000 补漆钱，然后他次责赔了 2000 去医院检查... 真是太抽象了...", "content_rendered": "<p>提车半年，每天通勤 13 公里，早上 5 公里，晚上走高架 8 公里，虽说晚上距离远点而且上海南北高架很堵，但是开起来都比早上轻松太多了...</p>\n<p>几乎每天路上都能遇到电动车和自行车乱骑的，转弯回头观察也不会，电动车转向灯也没有，反正就是突然就要顶你车头前面转弯...</p>\n<p>早上又遇到一个大妈，我直行过 T 字路口速度降低到 20 就是怕电动车来个转弯，果不其然大妈一个左转直接顶我车头前面，给我吓得一把方向加急刹才停下，大妈挡风被贴着车屁股过去了，更恶心的是我到公司翻看记录仪，我后车也遇到了 A 柱盲区的电动车，我车刚停下电动车就往我车屁股和他车头的缝里钻，他刚起步又是一脚急刹，估计也是吓坏了...</p>\n<p>碰到了机动车高低是个次责，和同事吐槽，同事说被判过次责，电动车主责赔了 1000 补漆钱，然后他次责赔了 2000 去医院检查... 真是太抽象了...</p>\n", "last_modified": 1794796414, "replies": 73, "id": 1257304}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c74d/97b0/16_large.png?m=1727584731", "name": "share", "avatar_normal": "https://cdn.v2ex.com/navatar/c74d/97b0/16_normal.png?m=1727584731", "title": "分享发现", "url": "https://www.v2ex.com/go/share", "topics": 47763, "footer": "", "header": "分享你看到的好玩的，有信息量的，欢迎从这里获取灵感。", "title_alternative": "Share", "avatar_mini": "https://cdn.v2ex.com/navatar/c74d/97b0/16_mini.png?m=1727584731", "stars": 6400, "founder_id": 0, "aliases": [], "root": false, "id": 16, "parent_node_name": "v2ex"}, "member": {"id": 80990, "username": "JuSH", "url": "https://www.v2ex.com/u/JuSH", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/53c7/5bc5/80990_mini.png?m=1794790230", "avatar_normal": "https://cdn.v2ex.com/avatar/53c7/5bc5/80990_normal.png?m=1794790230", "avatar_large": "https://cdn.v2ex.com/avatar/53c7/5bc5/80990_large.png?m=1794790230", "created": 1415616850, "last_modified": 1794790230, "pro": 0}, "last_reply_by": "tudouxiong", "last_touched": 1794830085, "title": "微软悄悄上线了一款新的中文输入法", "url": "https://www.v2ex.com/t/1257291", "created": 1794791371, "deleted": 0, "content": "虽然名字叫中文输入法，但是目前仅支持拼音输入，估计后期会增加五笔输入。\r\n\r\n整体功能很简陋，皮肤不支持深色模式。\r\n\r\n看起来就是系统自带微软拼音的复刻，不知道微软为什么要重复造轮子。\r\n\r\n但是使用起来比微软拼音流畅不少，有种 30Hz 视频升级到 60Hz 的感觉，动画直追搜狗输入法。\r\n\r\n还有设置依然不支持关闭颜文字和 emoji。\r\n\r\n\r\n![微信图片_2026-11-16_085401_940.png](https://picui.ogmua.cn/s1/2026/11/16/6afa56ae3dbe5.webp)", "content_rendered": "<p>虽然名字叫中文输入法，但是目前仅支持拼音输入，估计后期会增加五笔输入。</p>\n<p>整体功能很简陋，皮肤不支持深色模式。</p>\n<p>看起来就是系统自带微软拼音的复刻，不知道微软为什么要重复造轮子。</p>\n<p>但是使用起来比微软拼音流畅不少，有种 30Hz 视频升级到 60Hz 的感觉，动画直追搜狗输入法。</p>\n<p>还有设置依然不支持关闭颜文字和 emoji。</p>\n<p><img alt=\"微信图片_2026-11-16_085401_940.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://picui.ogmua.cn/s1/2026/11/16/6afa56ae3dbe5.webp\"/></p>\n", "last_modified": 1794791371, "replies": 66, "id": 1257291}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24847, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3769, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 722068, "username": "SoulFlame", "url": "https://www.v2ex.com/u/SoulFlame", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/e07ae3c76edeb7f11da872fc5150e382?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/e07ae3c76edeb7f11da872fc5150e382?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/e07ae3c76edeb7f11da872fc5150e382?s=73&d=retro", "created": 1732588656, "last_modified": 1794823117, "pro": 0}, "last_reply_by": "w3cll", "last_touched": 1794826673, "title": "让你见识下 8 年 IOS 的实力", "url": "https://www.v2ex.com/t/1257359", "created": 1794798460, "deleted": 0, "content": "我：http://api.***em.top  \r\n对方：这个域名能把 top 改成其他的随机字母吗", "content_rendered": "我：http://api.***<a target=\"_blank\" href=\"http://em.top\" rel=\"nofollow noopener\">em.top</a>  <br />对方：这个域名能把 top 改成其他的随机字母吗", "last_modified": 1794798460, "replies": 63, "id": 1257359}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_large.png?m=1768280127", "name": "career", "avatar_normal": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_normal.png?m=1768280127", "title": "职场话题", "url": "https://www.v2ex.com/go/career", "topics": 24847, "footer": "", "header": "这里，我们聊聊那些工作中遇到的开心和不开心的事。", "title_alternative": "Career", "avatar_mini": "https://cdn.v2ex.com/navatar/4ea0/6fbc/770_mini.png?m=1768280127", "stars": 3769, "founder_id": 0, "aliases": [], "root": false, "id": 770, "parent_node_name": ""}, "member": {"id": 60254, "username": "zhouxiaoyuan", "url": "https://www.v2ex.com/u/zhouxiaoyuan", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/86627d4437e717912cab1cc235aba84e?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/86627d4437e717912cab1cc235aba84e?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/86627d4437e717912cab1cc235aba84e?s=73&d=retro", "created": 1397393303, "last_modified": 1397393303, "pro": 0}, "last_reply_by": "zhouxiaoyuan", "last_touched": 1794823471, "title": "都说 AI 大大提高了编程效率，真正失业的程序员多吗", "url": "https://www.v2ex.com/t/1257251", "created": 1794752657, "deleted": 0, "content": "我看身边大部分人都还苟着，有一些被裁员优化的，很多还是找到了新工作，不论好坏，有多卷，至少还有一份工作。只有一小部分人真的失业在家。另外，大家都再说经济下行，钱难赚。不知道这里的朋友们怎么样？", "content_rendered": "<p>我看身边大部分人都还苟着，有一些被裁员优化的，很多还是找到了新工作，不论好坏，有多卷，至少还有一份工作。只有一小部分人真的失业在家。另外，大家都再说经济下行，钱难赚。不知道这里的朋友们怎么样？</p>\n", "last_modified": 1794752707, "replies": 62, "id": 1257251}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/a016/1022/1212_large.png?m=1768102045", "name": "aigc", "avatar_normal": "https://cdn.v2ex.com/navatar/a016/1022/1212_normal.png?m=1768102045", "title": "人工智能", "url": "https://www.v2ex.com/go/aigc", "topics": 215, "footer": "不追求高深理论，更欢迎真实体验、实践总结和日常问题。", "header": "AI 不是万能的神，而是“能力照妖镜”。欢迎分享更多有趣、实用的 AI 工具、方法、应用场景。", "title_alternative": "人工智能", "avatar_mini": "https://cdn.v2ex.com/navatar/a016/1022/1212_mini.png?m=1768102045", "stars": 51, "founder_id": 494431, "aliases": [], "root": false, "id": 1212, "parent_node_name": null}, "member": {"id": 67385, "username": "yuyachen", "url": "https://www.v2ex.com/u/yuyachen", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/850acb400e8b140b5adf6d7652a45c53?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/850acb400e8b140b5adf6d7652a45c53?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/850acb400e8b140b5adf6d7652a45c53?s=73&d=retro", "created": 1404832041, "last_modified": 1404832041, "pro": 0}, "last_reply_by": "newmlp", "last_touched": 1794820610, "title": "我觉得 AI 的发展已经到头了", "url": "https://www.v2ex.com/t/1257274", "created": 1794769020, "deleted": 0, "content": "生产端 AI 只能解决从 1 到 10 从 1 到 100，越往后边际效益递减。\r\n1+1 算一万亿次也只能是 2，算不出花来。\r\n需求端一个人一天需要的东西在 AI 问世前后是区别不大的\r\n还是吃那么多东西还是消费那么多东西\r\n目前 AI 最大的作用就是在二进制世界替代人力，程序员演员等职业，这个也是有很明显的上边界的。", "content_rendered": "<p>生产端 AI 只能解决从 1 到 10 从 1 到 100，越往后边际效益递减。\n1+1 算一万亿次也只能是 2，算不出花来。\n需求端一个人一天需要的东西在 AI 问世前后是区别不大的\n还是吃那么多东西还是消费那么多东西\n目前 AI 最大的作用就是在二进制世界替代人力，程序员演员等职业，这个也是有很明显的上边界的。</p>\n", "last_modified": 1794769020, "replies": 60, "id": 1257274}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 243067, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4553, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 476881, "username": "Veliqo", "url": "https://www.v2ex.com/u/Veliqo", "website": "https://reqix-dev.github.io/reqix-website/", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "我的个人作品【reqix】API Mock、请求与响应修改、Header 编辑、URL 重定向、用户脚本管理、请求录制与 DevTools 接口调试\r\nhttps://chromewebstore.google.com/detail/reqix-%E2%80%93-api-mock-request/jglhpmlcngcdkkdfjphlgfgbdabckfji", "avatar_mini": "https://cdn.v2ex.com/avatar/4c6a/98fc/476881_mini.png?m=1794793290", "avatar_normal": "https://cdn.v2ex.com/avatar/4c6a/98fc/476881_normal.png?m=1794793290", "avatar_large": "https://cdn.v2ex.com/avatar/4c6a/98fc/476881_large.png?m=1794793290", "avatar_xlarge": "https://cdn.v2ex.com/avatar/4c6a/98fc/476881_xlarge.png?m=1794793290", "created": 1584321315, "last_modified": 1794793290, "pro": 0}, "last_reply_by": "vmoewill", "last_touched": 1794827661, "title": "一觉醒来，V 站升级了评论区 UI 交互，Polish 要为上次的事故付出代价了", "url": "https://www.v2ex.com/t/1257309", "created": 1794793488, "deleted": 0, "content": "之前我在 V 站节点提过升级的事情，当时感觉站长升级的意愿不大，虽然评论升级的呼声比较高，https://www.v2ex.com/t/1251696\r\n\r\n前一阵上次 Polish 升级产生了一次电脑卡死的事故，https://fast.v2ex.com/t/1254940\r\n\r\n感觉站长真的觉醒了，靠第三方插件提升用户体验终究不是一个可靠的路子，产品的用户体验应该主要由产品本身主导，而不是高度依赖第三方。\r\n\r\n\r\n下一步还有哪些有价值的更新呢？比如上传图片？\r\n\r\n\r\nPolish 第三方插件的效果图\r\nhttps://i.imgur.com/MqHNaHL.png \r\n\r\nV 站官方升级后效果图\r\n\r\nhttps://i.imgur.com/6k2nMfW.png", "content_rendered": "之前我在 V 站节点提过升级的事情，当时感觉站长升级的意愿不大，虽然评论升级的呼声比较高，<a target=\"_blank\" href=\"https://www.v2ex.com/t/1251696\">https://www.v2ex.com/t/1251696</a><br /><br />前一阵上次 Polish 升级产生了一次电脑卡死的事故，<a target=\"_blank\" href=\"https://fast.v2ex.com/t/1254940\" rel=\"nofollow noopener\">https://fast.v2ex.com/t/1254940</a><br /><br />感觉站长真的觉醒了，靠第三方插件提升用户体验终究不是一个可靠的路子，产品的用户体验应该主要由产品本身主导，而不是高度依赖第三方。<br /><br /><br />下一步还有哪些有价值的更新呢？比如上传图片？<br /><br /><br />Polish 第三方插件的效果图<br /><a target=\"_blank\" href=\"https://i.imgur.com/MqHNaHL.png\" rel=\"nofollow noopener\" target=\"_blank\"><img src=\"https://i.imgur.com/MqHNaHL.png\" class=\"embedded_image\" rel=\"noreferrer\"></a><br /><br />V 站官方升级后效果图<br /><br /><a target=\"_blank\" href=\"https://i.imgur.com/6k2nMfW.png\" rel=\"nofollow noopener\" target=\"_blank\"><img src=\"https://i.imgur.com/6k2nMfW.png\" class=\"embedded_image\" rel=\"noreferrer\"></a>", "last_modified": 1794793488, "replies": 54, "id": 1257309}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/1fc2/1400/864_large.png?m=1778522847", "name": "promotions", "avatar_normal": "https://cdn.v2ex.com/navatar/1fc2/1400/864_normal.png?m=1778522847", "title": "推广", "url": "https://www.v2ex.com/go/promotions", "topics": 15359, "footer": "", "header": "来自厂商的推广活动类主题，会被归类到这个节点。希望有情怀的产商们在发布推广内容时，主动选择发布到本节点下。点击 <a href=\"/help/node\">这里</a> 阅读 V2EX 的节点使用指南。", "title_alternative": "Promotions", "avatar_mini": "https://cdn.v2ex.com/navatar/1fc2/1400/864_mini.png?m=1778522847", "stars": 1532, "founder_id": 0, "aliases": [], "root": false, "id": 864, "parent_node_name": ""}, "member": {"id": 433697, "username": "WinterLord", "url": "https://www.v2ex.com/u/WinterLord", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/915f/d892/433697_mini.png?m=1780557126", "avatar_normal": "https://cdn.v2ex.com/avatar/915f/d892/433697_normal.png?m=1780557126", "avatar_large": "https://cdn.v2ex.com/avatar/915f/d892/433697_large.png?m=1780557126", "avatar_xlarge": "https://cdn.v2ex.com/avatar/915f/d892/433697_xlarge.png?m=1780557126", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/915f/d892/433697_xxlarge.png?m=1780557126", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/915f/d892/433697_xxxlarge.png?m=1780557126", "created": 1564816168, "last_modified": 1780557126, "pro": 0}, "last_reply_by": "senooo", "last_touched": 1794824589, "title": "[HyperAPI 中转站]的佬友们来领鸡蛋了，评论留 ID，送$10 体验额度", "url": "https://www.v2ex.com/t/1257320", "created": 1794794718, "deleted": 0, "content": "站点： https:/