.v2ex.com/navatar/fd2c/5e46/1135_mini.png?m=1751736785", "stars": 3464, "founder_id": 0, "aliases": [], "root": false, "id": 1135, "parent_node_name": "geek"}, "member": {"id": 412721, "username": "hefmt137", "url": "https://www.v2ex.com/u/hefmt137", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/e79b187e76b321a733265197a7e45360?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/e79b187e76b321a733265197a7e45360?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/e79b187e76b321a733265197a7e45360?s=73&d=retro", "created": 1557931234, "last_modified": 1787497888, "pro": 0}, "last_reply_by": "hydraegret", "last_touched": 1795799577, "title": "有人从 codex 弃坑转到 Antigravity 的没", "url": "https://www.v2ex.com/t/1260241", "created": 1795748566, "deleted": 0, "content": "真的要被 6.2Astra 的前端能力和防御性语言气哭了\r\n\r\n听说 Google 的 neon 非常好用平替 Opus5.5 了，是不是真的就是 agent 有点拉\r\n\r\ncodex 的 20x 快到期了听听小伙伴们的意见", "content_rendered": "<p>真的要被 6.2Astra 的前端能力和防御性语言气哭了</p>\n<p>听说 Google 的 neon 非常好用平替 Opus5.5 了，是不是真的就是 agent 有点拉</p>\n<p>codex 的 20x 快到期了听听小伙伴们的意见</p>\n", "last_modified": 1795748566, "replies": 96, "id": 1260241}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_large.png?m=1777132346", "name": "qna", "avatar_normal": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_normal.png?m=1777132346", "title": "问与答", "url": "https://www.v2ex.com/go/qna", "topics": 243286, "footer": "", "header": "<!--\r\n一个更好的世界需要你持续地提出好问题。\r\n-->", "title_alternative": "Questions and Answers", "avatar_mini": "https://cdn.v2ex.com/navatar/c20a/d4d7/12_mini.png?m=1777132346", "stars": 4555, "founder_id": 0, "aliases": [], "root": false, "id": 12, "parent_node_name": "v2ex"}, "member": {"id": 265057, "username": "lijilei", "url": "https://www.v2ex.com/u/lijilei", "website": "https://www.leolee.tech", "twitter": "", "psn": "", "github": "LeoLeeTech", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/d839/1bd0/265057_mini.png?m=1781074282", "avatar_normal": "https://cdn.v2ex.com/avatar/d839/1bd0/265057_normal.png?m=1781074282", "avatar_large": "https://cdn.v2ex.com/avatar/d839/1bd0/265057_large.png?m=1781074282", "avatar_xlarge": "https://cdn.v2ex.com/avatar/d839/1bd0/265057_xlarge.png?m=1781074282", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/d839/1bd0/265057_xxlarge.png?m=1781074282", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/d839/1bd0/265057_xxxlarge.png?m=1781074282", "created": 1509875019, "last_modified": 1781074282, "pro": 0}, "last_reply_by": "sudo123", "last_touched": 1795737873, "title": "求推荐: 怎么解决家庭超轻量的看电影/动画片需求", "url": "https://www.v2ex.com/t/1260279", "created": 1795752455, "deleted": 0, "content": "想付费(小钱)找一个永久(直到关站跑路)的看视频的方式, 两月看不了一次\r\n\r\n看 v 站一上午, 也没找到什么方案, 邀请码, 捐助之类的\r\n\r\n\r\n**我的设备** \r\n\r\n- 安卓电视, 笔记本电脑, 有一块移动硬盘(无 NAS)\r\n\r\n**场景及目前的办法**\r\n\r\n- 自己在电脑上: 电影名 + 在线. 视频一般比较糊, 免费嘛. \r\n> 付费的话想清晰一些, 1080p, 很常见的那些电影剧集就行\r\n\r\n- 孩子动画片在电视上: 找网盘资源 + 买日卡网盘账户下载到硬盘 \r\n> 能接受, 想更省事一些. 第一反应是想找免费的, 忘记去咸鱼买, 浪费大量时间, 所以想一次性付费, 永远去那下载. 下载也挺慢, 也浪费时间\r\n\r\n- 安卓电视(无魔法): 有时候临时起意想看: 影视 app + 某聚合网址, 很糊, 有广告, 很多源还不能放, 很多水印广告, 多人家庭场景很不方便, 试错成本挺大. \r\n\r\n> 在 v 站找了好大会都没找到当时参照的那个帖子, 所以我现在也都不知道怎么弄的了\r\n\r\n\r\n提前感谢大家!\r\n\r\n平时都是禁止孩子看电视的, 自己也没有看电影/剧集的习惯, 那些爱奇艺网飞会员太不合适了, 只是非常偶尔的看一次", "content_rendered": "<p>想付费(小钱)找一个永久(直到关站跑路)的看视频的方式, 两月看不了一次</p>\n<p>看 v 站一上午, 也没找到什么方案, 邀请码, 捐助之类的</p>\n<p><strong>我的设备</strong> </p>\n<ul>\n<li>安卓电视, 笔记本电脑, 有一块移动硬盘(无 NAS)</li>\n</ul>\n<p><strong>场景及目前的办法</strong></p>\n<ul>\n<li>自己在电脑上: 电影名 + 在线. 视频一般比较糊, 免费嘛. </li>\n</ul>\n<blockquote>\n<p>付费的话想清晰一些, 1080p, 很常见的那些电影剧集就行</p>\n</blockquote>\n<ul>\n<li>孩子动画片在电视上: 找网盘资源 + 买日卡网盘账户下载到硬盘 </li>\n</ul>\n<blockquote>\n<p>能接受, 想更省事一些. 第一反应是想找免费的, 忘记去咸鱼买, 浪费大量时间, 所以想一次性付费, 永远去那下载. 下载也挺慢, 也浪费时间</p>\n</blockquote>\n<ul>\n<li>安卓电视(无魔法): 有时候临时起意想看: 影视 app + 某聚合网址, 很糊, 有广告, 很多源还不能放, 很多水印广告, 多人家庭场景很不方便, 试错成本挺大. </li>\n</ul>\n<blockquote>\n<p>在 v 站找了好大会都没找到当时参照的那个帖子, 所以我现在也都不知道怎么弄的了</p>\n</blockquote>\n<p>提前感谢大家!</p>\n<p>平时都是禁止孩子看电视的, 自己也没有看电影/剧集的习惯, 那些爱奇艺网飞会员太不合适了, 只是非常偶尔的看一次</p>\n", "last_modified": 1795752924, "replies": 92, "id": 1260279}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_large.png?m=1733731195", "name": "programmer", "avatar_normal": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_normal.png?m=1733731195", "title": "程序员", "url": "https://www.v2ex.com/go/programmer", "topics": 74671, "footer": "", "header": "While code monkeys are not eating bananas, they're coding.", "title_alternative": "Programmer", "avatar_mini": "https://cdn.v2ex.com/navatar/94f6/d7e0/300_mini.png?m=1733731195", "stars": 9835, "founder_id": 0, "aliases": [], "root": false, "id": 300, "parent_node_name": "computer"}, "member": {"id": 206578, "username": "plasticee", "url": "https://www.v2ex.com/u/plasticee", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/gravatar/98ee0bc25d5d189530e4c586bb685719?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/98ee0bc25d5d189530e4c586bb685719?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/98ee0bc25d5d189530e4c586bb685719?s=73&d=retro", "created": 1482077518, "last_modified": 1791367807, "pro": 0}, "last_reply_by": "kenvix", "last_touched": 1795808225, "title": "为何新出的手机完全不支持 tf 卡了？", "url": "https://www.v2ex.com/t/1260288", "created": 1795755157, "deleted": 0, "content": "对于重写入场景，tf 卡还是有必要的，\r\n现在的大容量内置存储，好多用的 qlc 颗粒，可擦写次数有限，\r\n重写入用户，一天的写入量有可能达到几十 G，按这个写入量，手机存储折旧会挺快，\r\n如果支持 tf 卡，会好很多，\r\n为何厂商直接取消 tf 卡功能？一个 tf 卡功能能增加很多手机厚度么？不如把电池稍微搞小点", "content_rendered": "<p>对于重写入场景，tf 卡还是有必要的，<br/>\n现在的大容量内置存储，好多用的 qlc 颗粒，可擦写次数有限，<br/>\n重写入用户，一天的写入量有可能达到几十 G，按这个写入量，手机存储折旧会挺快，<br/>\n如果支持 tf 卡，会好很多，<br/>\n为何厂商直接取消 tf 卡功能？一个 tf 卡功能能增加很多手机厚度么？不如把电池稍微搞小点</p>\n", "last_modified": 1795755157, "replies": 88, "id": 1260288}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/bcc0/d400/1349_large.png?m=1779432800", "name": "airport", "avatar_normal": "https://cdn.v2ex.com/navatar/bcc0/d400/1349_normal.png?m=1779432800", "title": "机场", "url": "https://www.v2ex.com/go/airport", "topics": 27, "footer": "", "header": "让我们一起在网上愉快地冲浪吧！", "title_alternative": "机场", "avatar_mini": "https://cdn.v2ex.com/navatar/bcc0/d400/1349_mini.png?m=1779432800", "stars": 68, "founder_id": 317046, "aliases": [], "root": false, "id": 1349, "parent_node_name": null}, "member": {"id": 111002, "username": "Awes0me", "url": "https://www.v2ex.com/u/Awes0me", "website": "", "twitter": "", "psn": "", "github": "", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/9ad2/67ac/111002_mini.png?m=1767670953", "avatar_normal": "https://cdn.v2ex.com/avatar/9ad2/67ac/111002_normal.png?m=1767670953", "avatar_large": "https://cdn.v2ex.com/avatar/9ad2/67ac/111002_large.png?m=1767670953", "avatar_xlarge": "https://cdn.v2ex.com/avatar/9ad2/67ac/111002_xlarge.png?m=1767670953", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/9ad2/67ac/111002_xxlarge.png?m=1767670953", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/9ad2/67ac/111002_xxxlarge.png?m=1767670953", "created": 1429013905, "last_modified": 1767670953, "pro": 0}, "last_reply_by": "FlashEcho", "last_touched": 1795803895, "title": "有没有年付 1000-1500 左右的机场，要稳", "url": "https://www.v2ex.com/t/1260223", "created": 1795746378, "deleted": 0, "content": "给老板用的，奶昔，花云都不行，经常卡卡卡，一出问题就找我烦死了，dler 跑路以后转生成 oix 现在非要用它那个破客户端也不行，没有 iOS 的。\r\n\r\n其他便宜的不出名的也试过，连 ai 解锁都不稳\r\n\r\nwgetcloud 目前挺不错的，还想在买个备用的，不考虑自建，很麻烦。", "content_rendered": "<p>给老板用的，奶昔，花云都不行，经常卡卡卡，一出问题就找我烦死了，dler 跑路以后转生成 oix 现在非要用它那个破客户端也不行，没有 iOS 的。</p>\n<p>其他便宜的不出名的也试过，连 ai 解锁都不稳</p>\n<p>wgetcloud 目前挺不错的，还想在买个备用的，不考虑自建，很麻烦。</p>\n", "last_modified": 1795746378, "replies": 84, "id": 1260223}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 12172, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2562, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 254026, "username": "alphardex", "url": "https://www.v2ex.com/u/alphardex", "website": "https://haobinwang-2023.netlify.app/", "twitter": "alphardex007", "psn": "", "github": "alphardex", "btc": "", "location": "", "tagline": "個性捨てたら死んでるのと一緒だよ", "bio": "前端 | Shader | Creative Coding\r\nMyGO!!!!! | Roselia | 25时\r\nISTP-A\r\nPJSK同人游戏开发中\r\n做一辈子创作者", "avatar_mini": "https://cdn.v2ex.com/avatar/97d2/4647/254026_mini.png?m=1770873335", "avatar_normal": "https://cdn.v2ex.com/avatar/97d2/4647/254026_normal.png?m=1770873335", "avatar_large": "https://cdn.v2ex.com/avatar/97d2/4647/254026_large.png?m=1770873335", "avatar_xlarge": "https://cdn.v2ex.com/avatar/97d2/4647/254026_xlarge.png?m=1770873335", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/97d2/4647/254026_xxlarge.png?m=1770873335", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/97d2/4647/254026_xxxlarge.png?m=1770873335", "created": 1505222426, "last_modified": 1770873335, "pro": 0}, "last_reply_by": "dawn009", "last_touched": 1795805735, "title": "元旦准备飞到香港看 MyGO 演唱会，有点纠结要不要告诉父母", "url": "https://www.v2ex.com/t/1260214", "created": 1795744524, "deleted": 0, "content": "机酒、完整行程我自己已经安排好了，现在唯一纠结的是要不要跟父母说。\r\nOP 目前还是跟父母住在一起，所以这次出门几天，家里肯定会知道我不在。\r\n我家里对我二次元相关的消费一直都不太理解，觉得我太沉迷其中了，尤其是演唱会，他们觉得花几千块看一场根本没必要，而且这次还是专程从江苏飞去香港看，可能更加会觉得离谱。\r\n他们不止一次说你应该多存存钱，准备你以后的人生大事，像二次元这种消费，能少则少吧。\r\n如果直接告诉他们，估计免不了一顿质问和说教，甚至还会被阻拦（不过演唱会的票已经退不了了，而且我自己也已经决定要去）。\r\n但如果不说，或者编个单位去深圳团建之类的理由，又觉得太容易被戳破了。\r\n我自己有工作和储蓄，这次旅行的费用完全是我自己承担的，不会影响到日常生活。\r\n毕竟是跨境旅行，元旦又是连续几天不在家，还是会考虑要不要跟家里说一声。\r\n想问问 V 友们，如果是你们，会选择直接告诉父母，还是自己安排好就出发？", "content_rendered": "<p>机酒、完整行程我自己已经安排好了，现在唯一纠结的是要不要跟父母说。<br/>\nOP 目前还是跟父母住在一起，所以这次出门几天，家里肯定会知道我不在。<br/>\n我家里对我二次元相关的消费一直都不太理解，觉得我太沉迷其中了，尤其是演唱会，他们觉得花几千块看一场根本没必要，而且这次还是专程从江苏飞去香港看，可能更加会觉得离谱。<br/>\n他们不止一次说你应该多存存钱，准备你以后的人生大事，像二次元这种消费，能少则少吧。<br/>\n如果直接告诉他们，估计免不了一顿质问和说教，甚至还会被阻拦（不过演唱会的票已经退不了了，而且我自己也已经决定要去）。<br/>\n但如果不说，或者编个单位去深圳团建之类的理由，又觉得太容易被戳破了。<br/>\n我自己有工作和储蓄，这次旅行的费用完全是我自己承担的，不会影响到日常生活。<br/>\n毕竟是跨境旅行，元旦又是连续几天不在家，还是会考虑要不要跟家里说一声。<br/>\n想问问 V 友们，如果是你们，会选择直接告诉父母，还是自己安排好就出发？</p>\n", "last_modified": 1795744589, "replies": 79, "id": 1260214}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/70ef/df2e/17_large.png?m=1660301119", "name": "create", "avatar_normal": "https://cdn.v2ex.com/navatar/70ef/df2e/17_normal.png?m=1660301119", "title": "分享创造", "url": "https://www.v2ex.com/go/create", "topics": 39573, "footer": "", "header": "欢迎你在这里发布自己的最新作品！", "title_alternative": "Create", "avatar_mini": "https://cdn.v2ex.com/navatar/70ef/df2e/17_mini.png?m=1660301119", "stars": 6289, "founder_id": 0, "aliases": [], "root": false, "id": 17, "parent_node_name": "geek"}, "member": {"id": 237505, "username": "licoycn", "url": "https://www.v2ex.com/u/licoycn", "website": "", "twitter": "", "psn": "", "github": "Licoy", "btc": "", "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/avatar/e72f/93ee/237505_mini.png?m=1785372754", "avatar_normal": "https://cdn.v2ex.com/avatar/e72f/93ee/237505_normal.png?m=1785372754", "avatar_large": "https://cdn.v2ex.com/avatar/e72f/93ee/237505_large.png?m=1785372754", "avatar_xlarge": "https://cdn.v2ex.com/avatar/e72f/93ee/237505_xlarge.png?m=1785372754", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/e72f/93ee/237505_xxlarge.png?m=1785372754", "created": 1498570251, "last_modified": 1785372754, "pro": 0}, "last_reply_by": "fedfrank", "last_touched": 1795711461, "title": "最近 Antigravity 重置太频繁了，于是我上线了一个 Agy Reset 重置信号监测站，让你不错过每一次重置，且本贴随楼抽 50 位评论者每位赠送 50$V2EX", "url": "https://www.v2ex.com/t/1260187", "created": 1795740261, "deleted": 0, "content": "现在 Google 找到了属于他们自己的\"Tibo\" - Varun Mohan，而 OpenAI 的 Tibo 却不再是真正的\"Tibo\"。\r\n\r\n**站点地址：https://agyreset.com**\r\n\r\n如果监测到有重置排期、重置确认都会发布信号，订阅了邮件的都会进行推送，就不会让你错过每一次的重置，包括各个通知渠道都有机器或人工手动通知，尽全力不让你错过重置 😂 \r\n\r\n同时也提供开放 API、SKill、MCP 的集成，有需要可以自取集成～\r\n\r\n![image.png](https://s3.ap-tokyo-2.megas4.com/lotek4kvdldmsi7bcqlu5uekid66gkw5yt6jo/piclink-cn/2026/11/27/thFvjf2k.png)\r\n\r\n同时 [Quosparr](http://quosparr.com/)也集成了重置推送，一边观察额度，一边给你留意重置信号～\r\n\r\n![image.png](https://s3.ap-tokyo-2.megas4.com/lotek4kvdldmsi7bcqlu5uekid66gkw5yt6jo/piclink-cn/2026/11/27/zT4U3f8c.png)\r\n\r\n## 评论福利\r\n截止北京时间今日 21 点，随机抽取评论区 50 名回复者每位赠送 50 $V2EX ，注意若未绑定 SOL 则无法发放，视为无效，逾期不补。", "content_rendered": "<p>现在 Google 找到了属于他们自己的\"Tibo\" - Varun Mohan，而 OpenAI 的 Tibo 却不再是真正的\"Tibo\"。</p>\n<p><strong>站点地址：<a href=\"https://agyreset.com\" rel=\"nofollow\">https://agyreset.com</a></strong></p>\n<p>如果监测到有重置排期、重置确认都会发布信号，订阅了邮件的都会进行推送，就不会让你错过每一次的重置，包括各个通知渠道都有机器或人工手动通知，尽全力不让你错过重置 😂 </p>\n<p>同时也提供开放 API、SKill、MCP 的集成，有需要可以自取集成～</p>\n<p><img alt=\"image.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s3.ap-tokyo-2.megas4.com/lotek4kvdldmsi7bcqlu5uekid66gkw5yt6jo/piclink-cn/2026/11/27/thFvjf2k.png\"/></p>\n<p>同时 <a href=\"http://quosparr.com/\" rel=\"nofollow\">Quosparr</a>也集成了重置推送，一边观察额度，一边给你留意重置信号～</p>\n<p><img alt=\"image.png\" class=\"embedded_image\" loading=\"lazy\" referrerpolicy=\"no-referrer\" rel=\"noreferrer\" src=\"https://s3.ap-tokyo-2.megas4.com/lotek4kvdldmsi7bcqlu5uekid66gkw5yt6jo/piclink-cn/2026/11/27/zT4U3f8c.png\"/></p>\n<h2>评论福利</h2>\n<p>截止北京时间今日 21 点，随机抽取评论区 50 名回复者每位赠送 50 $V2EX ，注意若未绑定 SOL 则无法发放，视为无效，逾期不补。</p>\n", "last_modified": 1795740261, "replies": 73, "id": 1260187}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/02e7/4f10/27_large.png?m=1655527806", "name": "photograph", "avatar_normal": "https://cdn.v2ex.com/navatar/02e7/4f10/27_normal.png?m=1655527806", "title": "摄影", "url": "https://www.v2ex.com/go/photograph", "topics": 880, "footer": "", "header": "", "title_alternative": "Photograph", "avatar_mini": "https://cdn.v2ex.com/navatar/02e7/4f10/27_mini.png?m=1655527806", "stars": 1400, "founder_id": 0, "aliases": [], "root": false, "id": 27, "parent_node_name": "life"}, "member": {"id": 477915, "username": "vverr", "url": "https://www.v2ex.com/u/vverr", "website": "", "twitter": null, "psn": null, "github": null, "btc": null, "location": "", "tagline": "", "bio": "", "avatar_mini": "https://cdn.v2ex.com/gravatar/0d477d0a6d67ec2d7eeb09a3fe544a5a?s=24&d=retro", "avatar_normal": "https://cdn.v2ex.com/gravatar/0d477d0a6d67ec2d7eeb09a3fe544a5a?s=48&d=retro", "avatar_large": "https://cdn.v2ex.com/gravatar/0d477d0a6d67ec2d7eeb09a3fe544a5a?s=73&d=retro", "created": 1584723179, "last_modified": 1777216965, "pro": 0}, "last_reply_by": "fred986", "last_touched": 1795781368, "title": "2-3k 可以买到比较可以的相机吗", "url": "https://www.v2ex.com/t/1260208", "created": 1795743487, "deleted": 0, "content": "一直是手机拍照，录视频，不懂相机，预算也不多，2-3k，问下各位老板，这个价格可以买到一个比手机拍照好的相机吗，不用那么专业，照片比手机拍的清晰就好，手机的话目前是 iphone17，以及 oppo find，怎么说呢，手机拍照不是那么有感觉，我想如果有相机，那估计会更愿意拍一些东西（可能也不一定）\r\n\r\n1. 主要拍照，如果能摄像更好\r\n2. 比手机拍出来的好一些\r\n3. 2-3k\r\n4. 尽量不要大疆那种小型的 还是倾向相机那种造型\r\n\r\n这个价位，如果还不如手机，那我就不买了，如果还可以，选哪个比较好，还是说 jd 直接用这个价位搜购买多的就可以？", "content_rendered": "<p>一直是手机拍照，录视频，不懂相机，预算也不多，2-3k，问下各位老板，这个价格可以买到一个比手机拍照好的相机吗，不用那么专业，照片比手机拍的清晰就好，手机的话目前是 iphone17，以及 oppo find，怎么说呢，手机拍照不是那么有感觉，我想如果有相机，那估计会更愿意拍一些东西（可能也不一定）</p>\n<ol>\n<li>主要拍照，如果能摄像更好</li>\n<li>比手机拍出来的好一些</li>\n<li>2-3k</li>\n<li>尽量不要大疆那种小型的 还是倾向相机那种造型</li>\n</ol>\n<p>这个价位，如果还不如手机，那我就不买了，如果还可以，选哪个比较好，还是说 jd 直接用这个价位搜购买多的就可以？</p>\n", "last_modified": 1795746899, "replies": 64, "id": 1260208}]