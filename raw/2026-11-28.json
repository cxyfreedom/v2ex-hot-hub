[{"node": {"avatar_large": "https://cdn.v2ex.com/navatar/6e27/13a6/557_large.png?m=1747623425", "name": "life", "avatar_normal": "https://cdn.v2ex.com/navatar/6e27/13a6/557_normal.png?m=1747623425", "title": "生活", "url": "https://www.v2ex.com/go/life", "topics": 12172, "footer": "", "header": "生活中的技术讨论", "title_alternative": "Life", "avatar_mini": "https://cdn.v2ex.com/navatar/6e27/13a6/557_mini.png?m=1747623425", "stars": 2562, "founder_id": 0, "aliases": [], "root": false, "id": 557, "parent_node_name": ""}, "member": {"id": 512839, "username": "space2020", "url": "https://www.v2ex.com/u/space2020", "website": null, "twitter": null, "psn": null, "github": null, "btc": null, "location": null, "tagline": null, "bio": null, "avatar_mini": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_mini.png?m=1787107512", "avatar_normal": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_normal.png?m=1787107512", "avatar_large": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_large.png?m=1787107512", "avatar_xlarge": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_xlarge.png?m=1787107512", "avatar_xxlarge": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_xxlarge.png?m=1787107512", "avatar_xxxlarge": "https://cdn.v2ex.com/avatar/d9d6/8807/512839_xxxlarge.png?m=1787107512", "created": 1602686375, "last_modified": 1787107512, "pro": 0}, "last_reply_by": "ppokyou", "last_touched": 1795800638, "title": "周五好，大家周末打算干啥", "url": "https://www.v2ex.com/t/1260212", "created": 1795744125, "deleted": 0, "content": "人总是接近幸福的时候最快乐，周五应该是一周最开心的了；\r\n好好想想周末去干啥吧；\r\n周六跟前同事一起聚餐；\r\n然后就是准备看红果短剧《持械入宋》，看了第一季，感觉质量很高，\r\n好像是有 11 季，预估 1000 多集，有的看了；\r\n大家这周末准备干啥", "content_rendered": "<p>人总是接近幸福的时候最快乐，周五应该是一周最开心的了；<br/>\n好好想想周末去干啥吧；<br/>\n周六跟前同事一起聚餐；<br/>\n然后就是准备看红果短剧《持械入宋》，看了第一季，感觉质量很高，<br/>\n好像是有 11 季，预估 1000 多集，有的看了；<br/>\n大家这周末准备干啥</p>\n", "last_modified": 1795744125, "replies": 162, "id": 1260212}, {"node": {"avatar_large": "https://cdn.v2ex.com/navatar/df0a/ab05/1148_large.png?m=1751736790", "name": "claude", "av